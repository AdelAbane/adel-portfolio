---
import { localeBase, type Translations } from '../i18n';
import { garageCar as car } from '../lib/garage';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const about = t.about;
const base = localeBase(Astro.currentLocale);

// Three Edison bulbs on cords of different lengths; they come on one after the other
const bulbs = [
  { x: '26%', cord: '4.5cqw', delay: '0.9s' },
  { x: '50%', cord: '6cqw', delay: '1.25s' },
  { x: '74%', cord: '4.5cqw', delay: '1.6s' },
];
---

<!-- A world of its own: a cozy house garage that rolls open on a parked car -->
<section id="about" class="world-garage" aria-labelledby="about-title">
  <div class="wrap">
    <a class="back" href={base}>{about.back}</a>

    <div class="bay-head">
      <div>
        <p class="label">{about.label}</p>
        <h1 id="about-title" class="title">
          {about.titleLine1}<br /><span class="title-accent">{about.titleLine2}</span>
        </h1>
      </div>
      <button
        type="button"
        class="door-toggle"
        data-label-open={about.toggleOpen}
        data-label-close={about.toggleClose}
      >
        {about.toggleOpen}
      </button>
    </div>

    <div class="house">
      <span class="porch-light porch-left" aria-hidden="true"></span>
      <span class="porch-light porch-right" aria-hidden="true"></span>

      <div class="frame">
        <span class="spill spill-halo" aria-hidden="true"></span>

        <div class="garage">
          <!-- Interior: panelled wall, concrete floor, rug, flat props on the sides, hanging bulbs -->
          <div class="interior" aria-hidden="true">
            <div class="wall"></div>
            <div class="ceiling"></div>
            <div class="floor"></div>
            <!-- Light theme: afternoon sun through the door windows -->
            <span class="sun sun-left"></span>
            <span class="sun sun-right"></span>
            <div class="rug"></div>

            <svg class="prop poster poster-left" viewBox="0 0 30 40">
              <rect width="30" height="40" fill="#4E3522" />
              <rect x="2" y="2" width="26" height="36" fill="#1F4E9C" />
              <path d="M9 38 L15 2 H19 L13 38 Z M15 38 L21 2 H23 L17 38 Z" fill="#F2EFE6" />
            </svg>

            <svg class="prop poster poster-right" viewBox="0 0 30 40">
              <rect width="30" height="40" fill="#4E3522" />
              <rect x="2" y="2" width="26" height="18" fill="#9CC3EA" />
              <rect x="2" y="20" width="26" height="18" fill="#4F7A5A" />
              <circle cx="21" cy="11" r="3.5" fill="#FFD9A0" />
              <path d="M5 38 L14 20 H16 L25 38 Z" fill="#2A2A30" />
              <g fill="#F2EFE6">
                <rect x="14.6" y="22" width="0.8" height="3" />
                <rect x="14.5" y="27" width="1" height="3.5" />
                <rect x="14.4" y="32.5" width="1.2" height="4" />
              </g>
            </svg>

            <svg class="prop pegboard" viewBox="0 0 100 80">
              <defs>
                <pattern id="peg-holes" width="5" height="5" patternUnits="userSpaceOnUse">
                  <rect x="2" y="2" width="1.2" height="1.2" fill="#5E4630" />
                </pattern>
              </defs>
              <rect width="100" height="80" fill="#8A6A4A" />
              <rect width="100" height="80" fill="url(#peg-holes)" />
              <rect x="1" y="1" width="98" height="78" fill="none" stroke="#5E4630" stroke-width="2" />
              <!-- three wrenches, large to small -->
              <g fill="#B9BEC8">
                <rect x="8" y="12" width="4" height="36" />
                <circle cx="10" cy="12" r="5.5" />
                <circle cx="10" cy="49" r="4" />
                <rect x="19" y="12" width="3.4" height="28" />
                <circle cx="20.7" cy="12" r="4.6" />
                <circle cx="20.7" cy="41" r="3.4" />
                <rect x="29" y="12" width="2.8" height="21" />
                <circle cx="30.4" cy="12" r="3.8" />
                <circle cx="30.4" cy="34" r="2.8" />
              </g>
              <g fill="#8A6A4A">
                <rect x="8.4" y="5" width="3.2" height="6" />
                <rect x="19.3" y="6.4" width="2.8" height="5" />
                <rect x="29.2" y="7.4" width="2.4" height="4.2" />
                <circle cx="10" cy="49" r="1.8" />
                <circle cx="20.7" cy="41" r="1.5" />
                <circle cx="30.4" cy="34" r="1.2" />
              </g>
              <!-- hammer -->
              <rect x="47" y="15" width="4" height="36" fill="#5E4029" />
              <rect x="39" y="8" width="20" height="7" fill="#B9BEC8" />
              <rect x="39" y="15" width="4" height="3" fill="#B9BEC8" />
              <!-- pliers -->
              <path d="M66 10 L70 26 L68 50 L64 50 L66 27 Z" fill="#D63A2F" />
              <path d="M76 10 L72 26 L74 50 L78 50 L76 27 Z" fill="#D63A2F" />
              <rect x="68.5" y="22" width="5" height="6" fill="#B9BEC8" />
              <path d="M68.5 22 L67 8 L70 8 L71 22 Z M73.5 22 L75 8 L72 8 L71 22 Z" fill="#B9BEC8" />
              <!-- screwdriver -->
              <rect x="86" y="9" width="6" height="15" fill="#1F4E9C" />
              <rect x="88.3" y="24" width="1.4" height="24" fill="#B9BEC8" />
              <!-- hooks -->
              <g fill="#5E4630">
                <rect x="9" y="3" width="2" height="2" />
                <rect x="19.7" y="4.4" width="2" height="2" />
                <rect x="29.4" y="5.6" width="2" height="2" />
                <rect x="48" y="5" width="2" height="3" />
                <rect x="70" y="5" width="2" height="3" />
                <rect x="88" y="5" width="2" height="4" />
              </g>
            </svg>

            <svg class="prop shelves" viewBox="0 0 100 100">
              <g fill="#6B4A30">
                <rect x="2" y="0" width="4" height="100" />
                <rect x="94" y="0" width="4" height="100" />
                <rect x="0" y="30" width="100" height="3" />
                <rect x="0" y="64" width="100" height="3" />
                <rect x="0" y="97" width="100" height="3" />
              </g>
              <!-- boxes -->
              <rect x="10" y="10" width="30" height="20" fill="#A07A52" />
              <rect x="10" y="18" width="30" height="3" fill="#8A6440" />
              <rect x="44" y="15" width="22" height="15" fill="#B48A5E" />
              <rect x="70" y="18" width="20" height="12" fill="#A07A52" />
              <!-- oil bottles -->

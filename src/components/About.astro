              <rect x="17" y="38" width="4" height="4" fill="#1C1C21" />
              <rect x="12" y="51" width="8" height="7" fill="#1C1C21" />
              <path d="M26 64 V46 L30 42 H38 V64 Z" fill="#E0B04A" />
              <rect x="33" y="38" width="4" height="4" fill="#1C1C21" />
              <rect x="28" y="51" width="8" height="7" fill="#1C1C21" />
              <path d="M44 64 V48 L47 45 H53 V64 Z" fill="#D63A2F" />
              <rect x="49" y="42" width="3" height="3" fill="#1C1C21" />
              <rect x="58" y="44" width="14" height="20" fill="#1F4E9C" />
              <rect x="61" y="40" width="4" height="4" fill="#1C1C21" />
              <rect x="58" y="51" width="14" height="4" fill="#F2EFE6" />
              <rect x="76" y="48" width="14" height="16" fill="#A07A52" />
              <!-- bottom shelf: a parts bin and one more box -->
              <rect x="10" y="80" width="36" height="17" fill="#2A3A55" />
              <rect x="10" y="80" width="36" height="3" fill="#1F2B40" />
              <rect x="52" y="74" width="34" height="23" fill="#B48A5E" />
              <rect x="52" y="83" width="34" height="3" fill="#8A6440" />
            </svg>

            <svg class="prop extinguisher" viewBox="0 0 20 56">
              <rect x="2" y="24" width="16" height="3" fill="#3A3A42" />
              <rect x="3" y="12" width="14" height="42" rx="6" fill="#D63A2F" />
              <rect x="7" y="6" width="6" height="7" fill="#1C1C21" />
              <rect x="4" y="3" width="13" height="3" fill="#1C1C21" />
              <path d="M13 8 H18 V32" fill="none" stroke="#1C1C21" stroke-width="1.6" />
              <rect x="6" y="30" width="8" height="10" fill="#F2EFE6" />
            </svg>

            <svg class="prop toolchest" viewBox="0 0 60 92">
              <!-- wrenches lying on top -->
              <g fill="#B9BEC8">
                <rect x="8" y="3" width="20" height="2.4" />
                <circle cx="8" cy="4.2" r="2.8" />
                <rect x="34" y="4" width="15" height="2" />
                <circle cx="49" cy="5" r="2.3" />
              </g>
              <rect x="0" y="7" width="60" height="6" fill="#163A75" />
              <rect x="0" y="13" width="60" height="70" fill="#1F4E9C" />
              <g fill="#163A75">
                <rect x="0" y="24.5" width="60" height="1" />
                <rect x="0" y="36.5" width="60" height="1" />
                <rect x="0" y="48.5" width="60" height="1" />
                <rect x="0" y="60.5" width="60" height="1" />
                <rect x="0" y="72" width="60" height="1" />
              </g>
              <g fill="#C9D3E3">
                <rect x="18" y="17.5" width="24" height="1.4" />
                <rect x="18" y="29.5" width="24" height="1.4" />
                <rect x="18" y="41.5" width="24" height="1.4" />
                <rect x="18" y="53.5" width="24" height="1.4" />
                <rect x="18" y="65.5" width="24" height="1.4" />
                <rect x="18" y="77" width="24" height="1.4" />
              </g>
              <g fill="#1C1C21">
                <rect x="0" y="83" width="60" height="3" />
                <circle cx="6" cy="88.5" r="3.2" />
                <circle cx="21" cy="88.5" r="3.2" />
                <circle cx="39" cy="88.5" r="3.2" />
                <circle cx="54" cy="88.5" r="3.2" />
              </g>
            </svg>

            <svg class="prop stool" viewBox="0 0 30 36">
              <rect x="1" y="0" width="28" height="4" fill="#7A5536" />
              <g fill="#5A3E27">
                <path d="M5 4 H9 L7 36 H3 Z" />
                <path d="M21 4 H25 L27 36 H23 Z" />
                <rect x="5" y="22" width="20" height="2" />
              </g>
            </svg>

            <!-- Workbench with a retro radio, a mug and a work lamp; the tires sit under it -->
            <svg class="prop workbench" viewBox="0 0 100 100">
              <!-- radio -->
              <rect x="22" y="22" width="30" height="18" rx="3" fill="#E8DCC2" />
              <rect x="25" y="25" width="13" height="12" rx="1" fill="#A08F70" />
              <g fill="#E8DCC2">
                <rect x="25" y="28" width="13" height="1" />
                <rect x="25" y="31" width="13" height="1" />
                <rect x="25" y="34" width="13" height="1" />
              </g>
              <circle cx="45" cy="31" r="4" fill="#1F4E9C" />
              <rect x="44.5" y="27" width="1" height="4" fill="#E8DCC2" />
              <path d="M48 22 L58 8" stroke="#3A3A42" stroke-width="1" />
              <!-- mug -->
              <rect x="58" y="30" width="8" height="10" fill="#F2EFE6" />
              <rect x="58" y="33" width="8" height="2" fill="#1F4E9C" />
              <path d="M66 32 H69 V37 H66" fill="none" stroke="#F2EFE6" stroke-width="1.6" />
              <!-- work lamp -->
              <rect x="76" y="37" width="14" height="3" fill="#2A2A30" />
              <path d="M83 37 L79 22 L90 12" fill="none" stroke="#2A2A30" stroke-width="1.8" />
              <path d="M86 9 L94 13 L92 19 L84 15 Z" fill="#1F4E9C" />
              <!-- bench -->
              <rect x="0" y="40" width="100" height="6" fill="#7A5536" />
              <rect x="0" y="46" width="100" height="2" fill="#5E4029" />
              <g fill="#4E3522">
                <rect x="4" y="48" width="6" height="52" />
                <rect x="90" y="48" width="6" height="52" />
              </g>
            </svg>

            <svg class="prop tires" viewBox="0 0 60 72">
              <g fill="#1C1C21" stroke="#3A3A42" stroke-width="1.2">
                <rect x="1" y="49" width="58" height="22" rx="7" />
                <rect x="1" y="25" width="58" height="22" rx="7" />
                <rect x="1" y="1" width="58" height="22" rx="7" />
              </g>
              <!-- tread -->
              <g fill="#2A2A30">
                <rect x="9" y="5" width="2" height="14" /><rect x="17" y="5" width="2" height="14" /><rect x="25" y="5" width="2" height="14" /><rect x="33" y="5" width="2" height="14" /><rect x="41" y="5" width="2" height="14" /><rect x="49" y="5" width="2" height="14" />
                <rect x="9" y="29" width="2" height="14" /><rect x="17" y="29" width="2" height="14" /><rect x="25" y="29" width="2" height="14" /><rect x="33" y="29" width="2" height="14" /><rect x="41" y="29" width="2" height="14" /><rect x="49" y="29" width="2" height="14" />
                <rect x="9" y="53" width="2" height="14" /><rect x="17" y="53" width="2" height="14" /><rect x="25" y="53" width="2" height="14" /><rect x="33" y="53" width="2" height="14" /><rect x="41" y="53" width="2" height="14" /><rect x="49" y="53" width="2" height="14" />
              </g>
            </svg>

            <div class="shade"></div>
            <div class="lit"></div>

            {
              bulbs.map((bulb) => (
                <span class="bulb" style={`--x: ${bulb.x}; --cord: ${bulb.cord}; --delay: ${bulb.delay}`}>
                  <span class="bulb-glass" />
                  <span class="bulb-on" />
                </span>
              ))
            }
          </div>

          <div class="car">
            <span class="car-shadow" aria-hidden="true"></span>
            <picture class="car-reflection" aria-hidden="true">
              <source srcset={car.webp} type="image/webp" />
              <img src={car.png} width={car.width} height={car.height} alt="" decoding="async" />
            </picture>
            <picture>
              <source srcset={car.webp} type="image/webp" />
              <img
                src={car.png}
                width={car.width}
                height={car.height}
                alt={about.carAlt}
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <span class="hl hl-left" aria-hidden="true"></span>
            <span class="hl hl-right" aria-hidden="true"></span>
          </div>

          <a class="credit" href="https://instagram.com/e46gts" target="_blank" rel="noopener">{about.carCredit}</a>

          <!-- Sectional door: 5 panels, the top one glazed -->
          <div class="door" aria-hidden="true">
            <div class="panel panel-windows">
              <span class="window"></span>
              <span class="window"></span>
              <span class="window"></span>
              <span class="window"></span>
            </div>
            <div class="panel"></div>
            <div class="panel"></div>
            <div class="panel"></div>
            <div class="panel panel-handle"></div>
          </div>
        </div>

        <span class="spill spill-floor" aria-hidden="true"></span>
      </div>

      <div class="apron" aria-hidden="true"></div>
    </div>

    <div class="bay-bar">
      <p class="bay-name">
        {about.bayLabel} <strong>{about.bayCar}</strong>
      </p>
      <p class="bay-text">{about.bayText}</p>
    </div>

    <div class="bay-body">
      <div class="bio">
        {about.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="spec">
        <h2 class="spec-title">{about.specTitle}</h2>
        <dl>
          {about.specs.map((spec) => (
            <div class="spec-row">
              <dt>{spec.label}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <a class="next" href={`${base}#projects`}>{about.next} <span aria-hidden="true">→</span></a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.world-garage');
  const house = section?.querySelector<HTMLElement>('.house');
  const toggle = section?.querySelector<HTMLButtonElement>('.door-toggle');

  if (section && house && toggle) {
    let played = false;

    const setOpen = (open: boolean) => {
      section.classList.toggle('is-open', open);
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.textContent = label;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) playOnce();
      },
      { threshold: 0.35 },
    );

    // The door sequence runs once per page visit; the toggle replays it by hand
    function playOnce() {
      if (played) return;
      played = true;
      observer.disconnect();
      setOpen(true);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      playOnce();
    } else if (document.documentElement.hasAttribute('data-warp-arrival')) {
      // Came through the START portal: Base.astro fades the cover out first, then the door opens
      document.addEventListener('warp:arrived', () => window.setTimeout(playOnce, 300), { once: true });
    } else {
      observer.observe(house);
    }

    toggle.addEventListener('click', () => {
      played = true;
      observer.disconnect();
      setOpen(!section.classList.contains('is-open'));
    });
  }
</script>

<style>
  /* ---------- The garage world: own palette and fonts, scoped to this section ---------- */

  /* Dark theme (default): a cozy evening, bulbs glowing */
  .world-garage {
    --g-bg: #0E1118;
    --g-surface: #161B26;
    --g-line: #2A3242;
    --g-text: #F2F2F2;
    --g-text-2: #C9C9CF;
    --g-muted: #9A9AA3;
    --g-accent: #4A9EFF;
    --g-on-accent: #0B1220;

    --g-siding: #1A1B20;
    --g-siding-line: rgb(0 0 0 / 0.4);
    --g-eave: #0B0C10;
    --g-trim: #2A2D36;
    --g-apron: #24252B;
    --g-wall: #14223A;
    --g-panel-line: rgb(0 0 0 / 0.32);
    --g-ceiling: #0D1729;
    --g-floor: #34302B;
    --g-floor-edge: #1E1C19;
    --g-door: #3A3F4B;
    --g-door-seam: #1F2229;
    --g-door-glass: #101B2C;
    --g-cord: #0B0C10;
    --g-bulb-off: #5A5040;
    --g-shade: rgb(4 6 12 / 0.8);
    --g-credit: #B4B4BC;
    --g-credit-hover: #7DB8FF;
    --g-porch-glass: #FFE2A8;

    /* Strength of each light, faded with opacity so the theme switch stays smooth */
    --g-porch-glow: 1;
    --g-lit: 1;
    --g-bulb-glow: 1;
    --g-spill: 1;
    --g-sun: 0;

    --g-warm: 255 217 160;
    --g-font-head: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    --g-font-body: 'Barlow', system-ui, sans-serif;
    --g-font-label: 'JetBrains Mono', ui-monospace, monospace;

    /* Headlight centers over the car image, as a share of its box */
    --hl-left-x: 19.5%;
    --hl-right-x: 80.5%;
    --hl-y: 55.5%;

    position: relative;
    min-height: 100vh;
    padding: 32px 0 112px;
    background: var(--g-bg);
    color: var(--g-text);
    font-family: var(--g-font-body);
    overflow: hidden;
  }

  /* Light theme: a cozy Saturday afternoon, sun through the door windows, porch lights off */
  :global([data-theme='light']) .world-garage {
    --g-bg: #F4F1EB;
    --g-surface: #FFFFFF;
    --g-line: #D9D3C8;
    --g-text: #14223A;
    --g-text-2: #33465F;
    --g-muted: #52627A;
    --g-accent: #1F5FC4;
    --g-on-accent: #FFFFFF;

    --g-siding: #E8E4DC;
    --g-siding-line: rgb(60 50 40 / 0.14);
    --g-eave: #C9C3B8;
    --g-trim: #F7F5F0;
    --g-apron: #D8D2C8;
    --g-wall: #C9DDF2;
    --g-panel-line: rgb(20 34 58 / 0.12);
    --g-ceiling: #B4CBE3;
    --g-floor: #CFC7BB;
    --g-floor-edge: #A89F92;
    --g-door: #F2F0EB;
    --g-door-seam: #C9C3B8;
    --g-door-glass: #9FB8D3;
    --g-cord: #3A3F4B;
    --g-bulb-off: #D8CBB0;
    --g-shade: rgb(30 40 60 / 0.35);
    --g-credit: #3A475B;
    --g-credit-hover: #163F85;
    --g-porch-glass: #D8D4CC;

    --g-porch-glow: 0;
    --g-lit: 0.35;
    --g-bulb-glow: 0.45;
    --g-spill: 0.3;
    --g-sun: 1;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ---------- Back link and header row ---------- */

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 40px;
    padding: 0 14px;
    border: 1px solid var(--g-line);
    font-family: var(--g-font-label);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--g-text-2);
    text-decoration: none;
  }

  .back:hover {
    border-color: var(--g-accent);
    color: var(--g-accent);
  }

  .bay-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    font-family: var(--g-font-label);
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--g-accent);
  }

  .label::before {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--g-accent);
  }

  .title {
    margin: 0;
    font-family: var(--g-font-head);

---
import TechIcon from './TechIcon.astro';
import { localeBase, type Translations } from '../i18n';
import { garageCar as car } from '../lib/garage';
import ModelCredit from './ModelCredit.astro';
import QuoteCard from './QuoteCard.astro';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const about = t.about;
const base = localeBase(Astro.currentLocale);

/*
 * The room is one 1440 × 960 drawing in one-point perspective (vanishing point at 720, 355): the
 * back wall is the rectangle 380–1060 × 110–600 and every other edge runs from a screen corner to
 * one of its corners. The lights live in the same drawing, so they crop and scale with the room.
 */

// Edison bulbs: x on the ceiling, cord length, when it comes on, how slowly it sways. Each casts a
// cone down to a pool of light on the floor.
const bulbs = [
  { x: 562, cord: 150, delay: '0.5s', sway: '6s' },
  { x: 907, cord: 120, delay: '0.85s', sway: '7.2s' },
].map(({ x, cord, delay, sway }) => {
  const top = cord + 26;
  return {
    x,
    cord,
    delay,
    sway,
    cone: `${x - 17},${top} ${x + 17},${top} ${x + 170},746 ${x - 170},746`,
    poolY: cord > 130 ? 765 : 735,
  };
});

// Dust in the beams: [x, y, seconds into its 7s drift]
const dust = [
  [518, 384, 0], [562, 528, 1.2], [605, 336, 2.4], [533, 672, 3.1], [634, 595, 4.2], [576, 461, 5.3], [547, 288, 6.1],
  [864, 432, 0.6], [907, 557, 1.8], [950, 365, 2.9], [878, 691, 3.7], [922, 499, 4.8], [965, 634, 5.6], [893, 307, 6.5],
];

// Stars in the back window (night only)
const stars = [[475, 192], [504, 250], [547, 182], [576, 278], [490, 288], [562, 221], [590, 202], [518, 259]];

// Panel seams: back wall verticals, side wall verticals (left, mirrored right)
const backSeams = [465, 550, 635, 805, 890, 975];
const sideSeams = [
  [80, 23, 884],
  [170, 49, 799],
  [260, 75, 714],
  [330, 96, 647],
];
// Floor tiles: lines from the back edge to the front, and rows getting wider towards the viewer
const tileRays = [[380, -130], [465, 82], [550, 295], [635, 507], [720, 720], [805, 932], [890, 1145], [975, 1357], [1060, 1570]];
const tileRows = [625, 660, 712, 790, 900];
---

<!-- BAY 02: the inside of a garage at night, in one-point perspective, with a toolbox and a car to open -->
<section class="garage" aria-labelledby="about-title">
  <div class="layer room" data-depth="8" aria-hidden="true">
    <div class="room-view">
      <svg class="room-svg" viewBox="0 0 1440 960" preserveAspectRatio="xMidYMid slice">
        <defs>
          <clipPath id="floor-clip"><polygon points="0,960 1440,960 1060,600 380,600" /></clipPath>
          <radialGradient id="bulb-glow">
            <stop offset="0" stop-color="#FFC882" stop-opacity="0.7" />
            <stop offset="1" stop-color="#FFC882" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="day-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7EC2FF" />
            <stop offset="1" stop-color="#DDF1FF" />
          </linearGradient>
        </defs>

        <!-- Surfaces -->
        <polygon class="ceiling" points="0,0 1440,0 1060,110 380,110" />
        <polygon class="side" points="0,0 380,110 380,600 0,960" />
        <polygon class="side" points="1440,0 1060,110 1060,600 1440,960" />
        <rect class="back" x="380" y="110" width="680" height="490" />
        <polygon class="floor" points="0,960 1440,960 1060,600 380,600" />

        <!-- Wall panels and floor tiles -->
        <g class="back-seams">{backSeams.map((x) => <line x1={x} y1="110" x2={x} y2="600" />)}</g>
        <g class="side-seams">
          {sideSeams.map(([x, y1, y2]) => <line x1={x} y1={y1} x2={x} y2={y2} />)}
          {sideSeams.map(([x, y1, y2]) => <line x1={1440 - x} y1={y1} x2={1440 - x} y2={y2} />)}
        </g>
        <g class="tiles" clip-path="url(#floor-clip)">
          {tileRays.map(([x1, x2]) => <line x1={x1} y1="600" x2={x2} y2="960" />)}
          {tileRows.map((y) => <line x1="0" y1={y} x2="1440" y2={y} />)}
        </g>
        <ellipse class="stain" cx="560" cy="820" rx="150" ry="34" />

        <!-- Shadows along the seams where the surfaces meet -->
        <g class="seam seam-floor">
          <line x1="380" y1="600" x2="1060" y2="600" />
          <line x1="0" y1="960" x2="380" y2="600" />
          <line x1="1440" y1="960" x2="1060" y2="600" />
        </g>
        <g class="seam seam-top">
          <line x1="380" y1="110" x2="1060" y2="110" />
          <line x1="0" y1="0" x2="380" y2="110" />
          <line x1="1440" y1="0" x2="1060" y2="110" />
          <line x1="380" y1="110" x2="380" y2="600" />
          <line x1="1060" y1="110" x2="1060" y2="600" />
        </g>

        <!-- Garage door tracks on the ceiling, and the opener with its blinking LED -->
        <g class="track">
          <line x1="300" y1="0" x2="428" y2="110" />
          <line x1="1140" y1="0" x2="1012" y2="110" />
        </g>
        <rect class="opener" x="682" y="36" width="76" height="30" rx="4" />
        <line class="opener-rail" x1="720" y1="66" x2="720" y2="110" />
        <rect class="led-glow" x="740" y="44" width="14" height="14" rx="7" />
        <rect class="led" x="744" y="48" width="6" height="6" />

        <!-- Back window: night sky with a moon and stars, or daylight -->
        <rect class="window-frame" x="430" y="160" width="190" height="150" />
        <rect class="window-glass" x="440" y="170" width="170" height="130" />
        <g class="night-only">
          <path class="moon" d="M460 186h16v16h-16zM466 186h10v10h-10z" fill-rule="evenodd" />
          {stars.map(([x, y], i) => <rect class="star" x={x} y={y} width="3" height="3" style={`animation-delay: ${(i * 0.3).toFixed(1)}s`} />)}
        </g>
        <g class="day-only">
          <rect class="sun" x="566" y="184" width="22" height="22" />
          <path class="cloud" d="M452 262h44v-8h12v-8h20v8h10v8h8v8h-94z" />
        </g>
        <line class="window-frame-line" x1="525" y1="170" x2="525" y2="300" />

        <!-- Pegboard with tools -->
        <rect class="pegboard" x="680" y="160" width="300" height="200" />
        <g class="tool-a">
          <rect x="710" y="190" width="12" height="90" rx="3" />
          <rect x="740" y="200" width="10" height="70" rx="3" />
          <rect x="766" y="210" width="8" height="54" rx="3" />
        </g>
        <g class="tool-b">
          <rect x="800" y="196" width="60" height="16" rx="3" />
          <rect x="826" y="212" width="8" height="60" rx="2" />
          <path d="M890 196 L910 196 L920 270 L912 272 L900 214 L888 272 L880 270 Z" />
          <rect x="940" y="200" width="10" height="80" rx="3" />
          <rect class="accent" x="937" y="200" width="16" height="22" rx="3" />
        </g>

        <!-- Workbench with a radio and a mug -->
        <rect class="wood" x="840" y="470" width="210" height="16" />
        <rect class="wood-dark" x="852" y="486" width="10" height="114" />
        <rect class="wood-dark" x="1028" y="486" width="10" height="114" />
        <rect class="radio" x="870" y="432" width="64" height="38" rx="5" />
        <circle class="speaker" cx="888" cy="451" r="9" />
        <rect class="mug" x="950" y="444" width="20" height="26" rx="3" />

        <!-- Shelves with bottles and boxes -->
        <rect class="shelf" x="400" y="400" width="140" height="10" />
        <rect class="shelf" x="400" y="470" width="140" height="10" />
        <rect class="accent" x="410" y="370" width="16" height="30" rx="3" />
        <rect class="bottle-pale" x="432" y="378" width="16" height="22" rx="3" />
        <rect class="box" x="470" y="372" width="40" height="28" />
        <rect class="box-dark" x="414" y="440" width="44" height="30" />
        <rect class="bottle-red" x="470" y="446" width="18" height="24" rx="3" />

        <!-- Edison bulbs: a cone of warm light down to a pool on the floor -->
        {bulbs.map((bulb) => (
          <g class="bulb" style={`--delay: ${bulb.delay}; --sway: ${bulb.sway}`}>
            <polygon class="cone flick" points={bulb.cone} />
            <ellipse class="pool" cx={bulb.x} cy={bulb.poolY} rx="190" ry="35" />
            <g class="sway">
              <line class="cord" x1={bulb.x} y1="0" x2={bulb.x} y2={bulb.cord} />
              <circle class="glow flick" cx={bulb.x} cy={bulb.cord + 15} r="44" />
              <rect class="socket" x={bulb.x - 5} y={bulb.cord - 4} width="10" height="6" />
              <rect class="bulb-glass flick" x={bulb.x - 11} y={bulb.cord} width="22" height="30" rx="11" ry="13" />
            </g>
          </g>
        ))}
        <g class="dust">
          {dust.map(([x, y, at]) => <circle cx={x} cy={y} r="1.5" style={`animation-delay: -${at}s`} />)}
        </g>
      </svg>
      <div class="vignette"></div>
    </div>
  </div>

  <div class="layer tires" data-depth="30" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <!-- The glass headline card is gone for now (about.label and the title keys stay in en/fr.json); screen readers still get the page's title -->
  <h1 id="about-title" class="sr-only">{about.titleLine1} {about.titleLine2}</h1>

  <div class="layer car" data-depth="16">
    <span class="car-shadow" aria-hidden="true"></span>
    <picture>
      <source srcset={car.webp} type="image/webp" />
      <img src={car.png} width={car.width} height={car.height} alt={about.carAlt} decoding="async" fetchpriority="high" draggable="false" />
    </picture>
    <!-- 3D only: shown while the car model downloads -->
    <p class="glass car-loading" role="status" hidden>
      <span class="car-loading-light" aria-hidden="true"></span>{about.carLoading}<span class="car-loading-progress" aria-hidden="true"></span>
    </p>
    <div class="hood">
      <button
        type="button"
        class="glass hood-toggle"
        aria-expanded="false"
        aria-controls="hood-sheet"
        data-label-open={about.hoodOpen}
        data-label-close={about.hoodClose}
      >
        {about.hoodOpen}
      </button>
    </div>
    <div id="hood-sheet" class="glass sheet" hidden>
      <div class="sheet-head">
        <h2 class="sheet-title">{about.hoodTitle}</h2>
        <span class="sheet-tag" aria-hidden="true">{about.hoodTag}</span>
      </div>
      <dl class="specs">
        {about.specs.map((spec) => (
          <div class="spec">
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="layer toolbox" data-depth="28">
    <div class="chest" role="group" aria-label={about.toolbox.name}>
      <span class="chest-label" aria-hidden="true">{about.toolbox.label}</span>
      {about.toolbox.drawers.map((drawer, i) => (
        <button type="button" class="drawer" aria-expanded="false" aria-controls={`drawer-${i}`}>
          <span class="drawer-label">{drawer.label}</span>
          <span class="handle" aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <div class="casters" aria-hidden="true"><span></span><span></span></div>
    {about.toolbox.drawers.map((drawer, i) => (
      <div id={`drawer-${i}`} class="glass skills" hidden>
        <h2 class="skills-title">{drawer.title}</h2>
        <ul class="chips">{drawer.items.map((item) => <li><TechIcon name={item} />{item}</li>)}</ul>
      </div>
    ))}
  </div>

  <div class="bottom">
    <!-- The drawing's credit, or the 3D model's (CC BY 4.0) once the 3D garage is showing -->
    <p class="credit">
      <a class="credit-drawing" href="https://instagram.com/e46gts" target="_blank" rel="noopener">{about.carCredit}</a>
      <ModelCredit t={t} class="credit-model" />
    </p>
    <div class="glass bio">
      <p class="bio-lead">{about.bio[0]}</p>
      <p class="bio-more">{about.bio[1]}</p>
    </div>

    <div class="glass next-card">
      <p class="hint">{about.hint}</p>
      <a class="next" href={`${base}#projects`}>{about.next} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <!-- Lavoisier: upper right on wide screens; on phones it comes right after the bio -->
  <QuoteCard t={t} class="garage-quote" />

  <!-- Arrival: a closed sectional door over the whole screen rolls up (with JS and motion only) -->
  <div class="door" aria-hidden="true">
    <div class="panel panel-windows"><span></span><span></span><span></span><span></span></div>
    <div class="panel"></div>
    <div class="panel"></div>
    <div class="panel panel-handle"></div>
    <div class="panel"></div>
  </div>
</section>

<script>
  import type { GarageLayout, GarageScene, Rect, Theme } from '../lib/garage-three';
  import { downgrade, getSettings, settingsFor } from '../lib/quality';

  const garage = document.querySelector<HTMLElement>('.garage');
  if (garage) initGarage(garage);

  function initGarage(garage: HTMLElement) {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const wide = window.matchMedia('(min-width: 768px)');
    const touch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    const door = garage.querySelector<HTMLElement>('.door')!;
    const roomView = garage.querySelector<HTMLElement>('.room-view')!;
    const carLayer = garage.querySelector<HTMLElement>('.layer.car')!;
    const toolbox = garage.querySelector<HTMLElement>('.layer.toolbox')!;
    const chest = toolbox.querySelector<HTMLElement>('.chest')!;
    const chestLabel = toolbox.querySelector<HTMLElement>('.chest-label')!;
    const carLoading = carLayer.querySelector<HTMLElement>('.car-loading')!;
    const carProgress = carLoading.querySelector<HTMLElement>('.car-loading-progress')!;

    // The three.js garage, once it has taken over from the drawing
    let scene: GarageScene | null = null;

    // ---------- Arrival: the door rolls up (~2.4s) and the bulbs flicker on ----------

    function open() {
      garage.classList.add('is-open');
      door.addEventListener('transitionend', () => (door.hidden = true), { once: true });
    }

    const portal = root.hasAttribute('data-warp-arrival');
    // Came through the START portal: Base.astro fades its cover out first
    const portalDone = new Promise<void>((resolve) => {
      if (portal) document.addEventListener('warp:arrived', () => resolve(), { once: true });
      else resolve();
    });

    // ---------- 3D: only where it can run smoothly, otherwise the drawing stays ----------

    // The tier decides (quality.ts: low = no three.js); ?3d=0 keeps the CSS garage anyway
    const choice = new URLSearchParams(window.location.search).get('3d');
    let quality = getSettings();
    const want3d = quality.three && choice !== '0';
    const firstVisit = !sessionFlag('garage-arrived');

    if (reducedMotion.matches) {
      door.hidden = true;
      garage.classList.add('is-open');
    } else if (!want3d) {
      portalDone.then(() => window.setTimeout(open, portal ? 200 : 400));
    } else if (!firstVisit) {
      // The arrival plays once per visit: straight to the garage, then the 3D fades in
      door.hidden = true;
      garage.classList.add('is-open');
      load3d(false).then((ready) => ready && show3d(ready));
    } else {
      sessionFlag('garage-arrived', true);
      const ready = load3d(true);
      // The CSS door stays closed while three.js loads; if it takes too long, the CSS door opens
      portalDone
        .then(() => Promise.race([ready, new Promise<undefined>((resolve) => window.setTimeout(resolve, 2500))]))
        .then((result) => {
          if (result) return arrive3d(result);
          open();
          if (result === undefined) ready.then((late) => late && show3d(late));
        });
    }

    function sessionFlag(key: string, set?: boolean) {
      try {
        if (set) sessionStorage.setItem(key, '1');
        return sessionStorage.getItem(key) === '1';
      } catch {
        return false;
      }
    }

    const currentTheme = (): Theme => (root.dataset.theme === 'light' ? 'light' : 'dark');

    /** Builds the scene behind the drawing and checks it keeps up; null means stay with CSS */
    async function load3d(arrival: boolean): Promise<GarageScene | null> {
      const container = document.createElement('div');
      container.className = 'scene3d';
      roomView.querySelector('.vignette')!.before(container);
      try {
        const { createGarage } = await import('../lib/garage-three');
        const built = await createGarage({
          container,
          theme: currentTheme(),
          quality,
          touch,
          full: wide.matches,
          arrival,
          modelUrl: '/models/e46-opt.glb',
          dracoPath: '/draco/',
          onCarProgress: (progress) => {
            if (progress !== null) carProgress.textContent = ` ${Math.round(progress * 100)}%`;
          },
          onCarReady: () => {
            carLoading.hidden = true;
            garage.classList.add('is-car-in');
          },
          skillLabels: drawers.map((drawer) => drawer.querySelector('.drawer-label')!.textContent!.trim()),
          // A label round the holographic engine opens (or closes) its toolbox card
          onSkill: (index) => setDrawer(drawers[index].getAttribute('aria-expanded') === 'true' ? null : drawers[index]),
          onLayout: place,
          onReveal: reveal,
          onLost: leave3d,
          // Under 40fps over the first 3 seconds: one tier down (remembered), the CSS garage on low
          onSlow: () => {
            quality = settingsFor(downgrade());
            if (!quality.three) leave3d();
            else scene?.setQuality(quality);
          },
        });
        // For the ?debug overlay
        window.__renderStats = () => scene?.stats();
        return built;
      } catch {
        container.remove();
        return null;
      }
    }

    function activate(ready: GarageScene) {
      scene = ready;
      for (const { el } of layers) el.style.transform = '';
      garage.classList.add('is-3d');
      garage.classList.toggle('is-3d-full', wide.matches);
      // The drawing makes way for the model; a small loading state until it arrives
      if (!garage.classList.contains('is-car-in')) carLoading.hidden = false;
      // Once the crossfade is over, the drawing leaves the page (nothing can show it again, not even
      // a drag preview of the invisible image); it comes back only if the 3D garage stops
      window.clearTimeout(detachTimer);
      detachTimer = window.setTimeout(detachFallback, 900);
      const drawer = drawers.findIndex((d) => d.getAttribute('aria-expanded') === 'true');
      ready.setDrawer(drawer < 0 ? null : drawer);
      ready.setHood(!sheet.hidden);
      ready.start();
    }

    // The CSS garage's drawing: the room, the car picture and its shadow, the tires
    const fallback = [
      roomView.querySelector('.room-svg'),
      carLayer.querySelector('picture'),
      carLayer.querySelector('.car-shadow'),
      garage.querySelector('.layer.tires'),
    ].map((el) => ({ el: el!, parent: el!.parentNode!, next: el!.nextSibling }));
    let detachTimer = 0;

    function detachFallback() {
      if (!scene) return;
      for (const part of fallback) part.el.remove();
    }

    function restoreFallback() {
      window.clearTimeout(detachTimer);
      for (const part of fallback) if (!part.el.isConnected) part.parent.insertBefore(part.el, part.next);
    }

    /** Crossfade from the drawing to the 3D garage at rest */
    function show3d(ready: GarageScene) {
      ready.skipArrival();
      activate(ready);
    }

    let skip: (() => void) | null = null;

    /** The CSS door fades into the same closed door in 3D, then it rises and the camera drives in */
    function arrive3d(ready: GarageScene) {
      garage.classList.add('is-arriving', 'is-3d-instant');
      activate(ready);
      door.classList.add('is-fading');
      window.setTimeout(() => {
        door.hidden = true;
        garage.classList.add('is-open');
        garage.classList.remove('is-3d-instant');
        ready.playArrival();
        // Any click or key skips the rest of it
        skip = () => ready.skipArrival();
        window.addEventListener('pointerdown', skip);
        window.addEventListener('keydown', skip);
      }, 500);
    }

    function reveal() {
      garage.classList.remove('is-arriving');
      if (skip) {
        window.removeEventListener('pointerdown', skip);
        window.removeEventListener('keydown', skip);
        skip = null;
      }
    }

    /** Back to the CSS garage (context lost, or leaving the page) */
    function leave3d() {
      reveal();
      scene?.dispose();
      scene = null;
      garage.querySelector('.scene3d')?.remove();
      restoreFallback();
      garage.classList.remove('is-3d', 'is-3d-full', 'is-3d-instant', 'is-chest-hover', 'is-car-in');
      carLoading.hidden = true;
      door.hidden = true;
      garage.classList.add('is-open');
    }

    window.addEventListener('pagehide', () => scene && leave3d());
    window.addEventListener('pageshow', (event) => {
      if (event.persisted && want3d && !scene) load3d(false).then((ready) => ready && show3d(ready));
    });

    new MutationObserver(() => scene?.setTheme(currentTheme())).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    wide.addEventListener('change', () => {
      if (!scene) return;
      garage.classList.toggle('is-3d-full', wide.matches);
      scene.setFull(wide.matches);
    });

    // ---------- Wide screens: the HTML buttons sit on the 3D car and chest ----------

    let origin: { x: number; y: number } | null = null;
    const headerHeight = () => parseFloat(getComputedStyle(root).getPropertyValue('--header-h')) || 82;
    new ResizeObserver(() => (origin = null)).observe(garage);

    const setBox = (el: HTMLElement, { x, y, w, h }: Rect) => {
      el.style.setProperty('--x', `${(x + origin!.x).toFixed(1)}px`);
      el.style.setProperty('--y', `${(y + origin!.y).toFixed(1)}px`);
      el.style.setProperty('--w', `${w.toFixed(1)}px`);
      el.style.setProperty('--h', `${h.toFixed(1)}px`);
    };

    function place(layout: GarageLayout) {
      if (!origin) {
        // The canvas' corner inside the section
        const canvas = roomView.querySelector('.scene3d')!.getBoundingClientRect();
        const section = garage.getBoundingClientRect();
        origin = { x: canvas.left - section.left, y: canvas.top - section.top };
      }
      // Hood mode brings the camera close: keep the hood button and the cards on screen
      const canvasBox = roomView.querySelector('.scene3d')!;
      const width = canvasBox.clientWidth;
      const height = canvasBox.clientHeight;
      const top = headerHeight() + 72 - origin.y;
      const car = { ...layout.car };
      const right = Math.min(car.x + car.w, width - 40);
      car.x = Math.max(car.x, 40);
      car.w = Math.max(0, right - car.x);
      car.y = Math.min(Math.max(car.y, top), height - 200);
      setBox(carLayer, car);
      // Hood mode: the spec sheet keeps to the right edge, clear of the hologram
      carLayer.style.setProperty('--sheet-x', `${(width - 40 - 460 - car.x).toFixed(1)}px`);
      setBox(chestLabel, layout.label);
      drawers.forEach((drawer, i) => setBox(drawer, layout.drawers[i]));
      // The skills card opens to the right of the chest
      const skillsX = Math.min(Math.max(layout.chest.x + layout.chest.w + 18, 40), width - 320);
      const skillsY = Math.min(Math.max(layout.chest.y + 8, top), height - 260);
      toolbox.style.setProperty('--skills-x', `${(skillsX + origin.x).toFixed(1)}px`);
      toolbox.style.setProperty('--skills-y', `${(skillsY + origin.y).toFixed(1)}px`);
    }

    // ---------- Parallax: each layer moves against the cursor by its depth (the 3D camera does it there) ----------

    const layers = [...garage.querySelectorAll<HTMLElement>('.layer')].map((el) => ({ el, depth: Number(el.dataset.depth) }));
    const pointer = { x: 0, y: 0 };
    let frame = 0;

    function render() {
      frame = 0;
      for (const { el, depth } of layers) {
        const x = (-pointer.x * depth).toFixed(1);
        const y = (-pointer.y * depth * 0.6).toFixed(1);
        el.style.transform = pointer.x || pointer.y ? `translate(${x}px, ${y}px)` : '';
      }
    }

    function follow(x: number, y: number) {
      pointer.x = x;
      pointer.y = y;
      if (scene) scene.pointer(x, y);
      else if (!frame) frame = requestAnimationFrame(render);
    }

    garage.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse' || !finePointer.matches || reducedMotion.matches) return;
        // -1…1 across the screen
        follow((event.clientX / window.innerWidth) * 2 - 1, (event.clientY / window.innerHeight) * 2 - 1);
        // The 3D chest lights up under the cursor
        if (scene) {
          const onUi = (event.target as Element).closest('button, a, .glass');
          garage.classList.toggle('is-chest-hover', scene.hover(event.clientX, event.clientY) && !onUi);
        }
      },
      { passive: true },
    );
    garage.addEventListener('pointerleave', () => {
      follow(0, 0);
      scene?.hover(-1, -1);
      garage.classList.remove('is-chest-hover');
    });

    // ---------- Toolbox: one drawer open at a time ----------

    const drawers = [...garage.querySelectorAll<HTMLButtonElement>('.drawer')];

    function setDrawer(open: HTMLButtonElement | null) {
      for (const drawer of drawers) {
        const isOpen = drawer === open;
        drawer.setAttribute('aria-expanded', String(isOpen));
        document.getElementById(drawer.getAttribute('aria-controls')!)!.hidden = !isOpen;
      }
      scene?.setDrawer(open ? drawers.indexOf(open) : null);
    }

    for (const drawer of drawers) {
      drawer.addEventListener('click', () => setDrawer(drawer.getAttribute('aria-expanded') === 'true' ? null : drawer));
    }

    // Clicking the 3D chest itself opens the next drawer (after the last one, it closes)
    garage.addEventListener('click', (event) => {
      if (!scene || !garage.classList.contains('is-3d-full')) return;
      if ((event.target as Element).closest('button, a, .glass')) return;
      if (!scene.hover(event.clientX, event.clientY)) return;
      const current = drawers.findIndex((d) => d.getAttribute('aria-expanded') === 'true');
      setDrawer(drawers[current + 1] ?? null);
    });

    // The HTML drawer buttons light the 3D chest up too
    for (const type of ['pointerenter', 'focusin']) chest.addEventListener(type, () => scene?.setChestHover(true));
    for (const type of ['pointerleave', 'focusout']) chest.addEventListener(type, () => scene?.setChestHover(false));

    // ---------- Pop the hood ----------

    const hoodToggle = garage.querySelector<HTMLButtonElement>('.hood-toggle')!;
    const sheet = garage.querySelector<HTMLElement>('#hood-sheet')!;

    function setHood(open: boolean) {
      hoodToggle.setAttribute('aria-expanded', String(open));
      hoodToggle.textContent = (open ? hoodToggle.dataset.labelClose : hoodToggle.dataset.labelOpen) ?? '';
      sheet.hidden = !open;
      // 3D: the camera moves to the front of the car and a holographic engine appears over the hood
      garage.classList.toggle('is-hood', open);
      scene?.setHood(open);
    }

    hoodToggle.addEventListener('click', () => setHood(sheet.hidden));

    // Escape closes what's open, and gives focus back to the button that opened it
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const drawer = drawers.find((d) => d.getAttribute('aria-expanded') === 'true');
      if (drawer) {
        setDrawer(null);
        drawer.focus();
      }
      if (!sheet.hidden) {
        setHood(false);
        hoodToggle.focus();
      }
    });

    // ---------- Hidden tab: every loop holds still (the 3D scene pauses itself) ----------

    const pause = () => garage.classList.toggle('is-paused', document.hidden);
    document.addEventListener('visibilitychange', pause);
    pause();

    // Dev only: lets the screenshot script hold the arrival at a given moment
    if (import.meta.env.DEV) (window as unknown as { __garage: () => GarageScene | null }).__garage = () => scene;
  }
</script>


---
import type { Translations } from '../i18n';
import JudoSprite from './JudoSprite.astro';
import { localeBase } from '../i18n';
import { garageCar } from '../lib/garage';
import { fighterVars, fighters } from '../lib/fighters';
import { judoFrames as f } from '../lib/judo';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const aboutHref = `${localeBase(Astro.currentLocale)}about`;

// ---------- Judo pixel art (24 × 28 at 4px, see src/lib/judo.ts) ----------

const PX = 4;
const width = (map: string[]) => Math.max(...map.map((row) => row.length));
const toriRoll = [1, 2, 3, 4, 5].map((i) => f[`toriRoll${i}`]);
const toriEntry = [f.toriEntry1, f.toriEntry2];
const toriLift = [f.toriLift1, f.toriLift2];
const ukeThrow = [0, 1, 2, 3].map((i) => f[`ukeThrow${i}`]);
// Before the script picks a random pair (and without JS): the first two fighters
const style = (vars: Record<string, string>) => Object.entries(vars).map(([k, v]) => `${k}: ${v}`).join('; ');
const toriDefault = style(fighterVars(fighters[0], 'white'));
const ukeDefault = style(fighterVars(fighters[1], 'blue'));
// Frames wider than 24 columns (the rotated roll frames) stay centered on the figure
const centered = (map: string[]) => `left: ${((24 - width(map)) * PX) / 2}px`;

// Landing dust at F5 of the roll: [dx, dy, size, colour]
const dust = [
  [-44, -8, 8, '#9AA3B5'],
  [-24, -20, 4, '#C9CFDA'],
  [12, -12, 8, '#C9CFDA'],
  [32, -20, 4, '#9AA3B5'],
  [52, -8, 8, '#C9CFDA'],
];

// Kata-guruma impact: a burst of dust to both sides of the landing point, and 4 white lines
const impactDust = [
  [-96, -12, 8, '#9AA3B5'],
  [-84, -32, 4, '#C9CFDA'],
  [-72, -8, 8, '#C9CFDA'],
  [-64, -40, 4, '#9AA3B5'],
  [-56, -20, 4, '#C9CFDA'],
  [56, -24, 4, '#C9CFDA'],
  [64, -40, 4, '#9AA3B5'],
  [72, -8, 8, '#C9CFDA'],
  [84, -32, 4, '#C9CFDA'],
  [96, -12, 8, '#9AA3B5'],
];
// Each line is 3 pixels on a diagonal or a row, pointing away from the landing point; [path, dx, dy]
// (dust and lines start out past the edges of his body, then fly further out)
const impactLines = [
  ['M0 0h4v4H0zM4 4h4v4H4zM8 8h4v4H8z', -56, -56],
  ['M0 8h4v4H0zM4 8h4v4H4zM8 8h4v4H8z', -76, -12],
  ['M0 8h4v4H0zM4 8h4v4H4zM8 8h4v4H8z', 76, -12],
  ['M0 8h4v4H0zM4 4h4v4H4zM8 0h4v4H8z', 56, -56],
] as const;

/*
 * The throw in Uke's coordinates (x from his standing spot, y up from the ground): the center of
 * each rotation step along the arc over Tori's right shoulder. The first one is also the lift.
 */
const throwSteps = [
  { cx: -8, cy: 104 },
  { cx: 20, cy: 140 },
  { cx: 48, cy: 112 },
  // The last step, already flat on the back, a hair above the mat: the next frame is the landing
  { cx: 72, cy: 12 + (f.ukeThrow3.body.length * PX) / 2 },
];
const throwFrames = ukeThrow.map((frame, i) => ({
  frame,
  left: throwSteps[i].cx - (width(frame.body) * PX) / 2,
  bottom: throwSteps[i].cy - (frame.body.length * PX) / 2,
}));

// ---------- Background: the pixel galaxy (drawn by src/lib/galaxy.ts) ----------

// Parallax depth: each star layer moves up to this many px against the cursor
const skyLayers = [
  { name: 'far', depth: 4 },
  { name: 'mid', depth: 10 },
  { name: 'near', depth: 18 },
];

// Reused by the script: the cursor trail and the floating "+100"s
const TRAIL_POOL = 40;
const letters = [...t.hero.title];
const POINTS_POOL = 6;
---

<section id="top" class="hero">
  <div class="sky" aria-hidden="true">
    <!-- Low tier (Lite mode, reduced motion, weak devices): the galaxy as a pre-rendered image -->
    <img class="sky-static sky-static-dark" src="/media/galaxy-static.webp" alt="" width="1600" height="846" loading="lazy" decoding="async" />
    <img class="sky-static sky-static-light" src="/media/galaxy-static-light.webp" alt="" width="1600" height="846" loading="lazy" decoding="async" />
    <canvas class="sky-canvas" width="320" height="180"></canvas>
    {skyLayers.map((layer) => <canvas class={`sky-layer sky-${layer.name}`} data-depth={layer.depth} width="0" height="0"></canvas>)}
  </div>

  <div class="content">
    <div class="hud" aria-hidden="true">
      <span><span class="hud-accent">{t.hero.hud.player}</span> <span class="hud-score">{t.hero.hud.score}</span></span>
      <span class="hud-hiscore">{t.hero.hud.hiScore} <span class="hud-accent">{t.hero.hud.hiScoreName}</span></span>
      <span class="blink hud-coin" data-high-score={t.hero.hud.highScore}>{t.hero.hud.insertCoin}</span>
    </div>
    <p class="sr-only" aria-live="polite" data-announce={t.hero.hud.scoreAnnounce}></p>

    <!-- One span per letter for the effects; screen readers get the name once, from the label -->
    <div class="name">
      <h1 aria-label={`.${t.hero.title}`}>
        <span class="title" aria-hidden="true">
          <span class="dot"></span><span class="letters">
            {letters.map((letter, i) => <span class="letter" style={`--i: ${i}`}><span class="glyph">{letter}</span></span>)}
            {['ghost-a', 'ghost-b'].map((ghost) => (
              <span class={`ghost ${ghost}`}>{letters.map((letter) => <span class="letter"><span class="glyph">{letter}</span></span>)}</span>
            ))}
          </span>
        </span>
        <span class="sweep" aria-hidden="true"></span>
      </h1>
      <!-- Game-menu selection, shown on hover -->
      <span class="select" aria-hidden="true">
        <span class="corner corner-tl"></span><span class="corner corner-tr"></span>
        <span class="corner corner-bl"></span><span class="corner corner-br"></span>
        <span class="arrow arrow-l">▶</span><span class="arrow arrow-r">◀</span>
      </span>
    </div>

    <div class="actions">
      <a class="btn btn-primary" href={aboutHref} data-warp data-warp-preload={garageCar.webp}>{t.hero.start}</a>
      <a class="btn btn-secondary" href="#contact">{t.hero.contact}</a>
    </div>
  </div>

  <!-- Everything else is a normal scroll away -->
  <a class="scroll-hint" href="#about"><span aria-hidden="true">▼</span> {t.hero.scroll}</a>

  <!-- Judo loop: every pose is stacked and swapped with opacity on one shared 12s timeline -->
  <div class="strip" aria-hidden="true">
    <div class="stage">
      <!-- 24px blocks with a top highlight, a bottom/right shadow and a couple of worn ones -->
      <svg class="ground" width="100%" height="24" shape-rendering="crispEdges">
        <defs>
          <pattern id="ground-blocks" width="192" height="24" patternUnits="userSpaceOnUse">
            <rect class="ground-base" width="192" height="24" />
            {Array.from({ length: 8 }, (_, i) => (
              <g transform={`translate(${i * 24} 0)`}>
                <rect class="ground-light" width="22" height="2" />
                <rect class="ground-dark" x="22" width="2" height="24" />
                <rect class="ground-dark" y="22" width="24" height="2" />
              </g>
            ))}
            <!-- A crack in block 3, pebbles in block 6, a chip in block 8 -->
            <path class="ground-dark" d="M56 4h2v4h2v4h2v2h2v4h-2v-2h-2v-4h-2v-4h-2z" />
            <path class="ground-dark" d="M126 8h2v2h-2zM134 14h2v2h-2zM130 18h2v2h-2z" />
            <path class="ground-light" d="M136 12h2v2h-2z" />
            <path class="ground-dark" d="M172 2h4v2h-2v2h-2z" />
          </pattern>
        </defs>
        <rect width="100%" height="24" fill="url(#ground-blocks)" />
      </svg>
      <div class="cast">
        <div class="actor tori" data-hair={fighters[0].style} style={toriDefault}>
          <svg class="shadow" width="56" height="12" shape-rendering="crispEdges"><path d="M8 0h40v4H8zM0 4h56v4H0zM8 8h40v4H8z" /></svg>
          <div class="tori-hop">
            <div class="frame t-walk">
              <JudoSprite frame={f.toriWalkA} size={PX} />
              <div class="frame walk-b"><JudoSprite frame={f.toriWalkB} size={PX} /></div>
            </div>
            <div class="frame t-stand"><JudoSprite frame={f.toriWalkA} size={PX} /></div>
            {toriRoll.map((frame, i) => (
              <div class={`frame t-roll-${i + 1}`} style={centered(frame.body)}><JudoSprite frame={frame} size={PX} /></div>
            ))}
            <div class="dust">
              {dust.map(([dx, dy, size, color]) => <span style={`--dx: ${dx}px; --dy: ${dy}px; --size: ${size}px; background: ${color}`}></span>)}
            </div>
            {toriEntry.map((frame, i) => <div class={`frame t-entry-${i + 1}`}><JudoSprite frame={frame} size={PX} /></div>)}
            {toriLift.map((frame, i) => <div class={`frame t-lift-${i + 1}`}><JudoSprite frame={frame} size={PX} /></div>)}
            <div class="frame t-throw"><JudoSprite frame={f.toriThrow} size={PX} /></div>
            <div class="frame t-ippon"><JudoSprite frame={f.toriIppon} size={PX} /></div>
          </div>
        </div>
        <div class="actor uke" data-hair={fighters[1].style} style={ukeDefault}>
          <svg class="shadow" width="56" height="12" shape-rendering="crispEdges"><path d="M8 0h40v4H8zM0 4h56v4H0zM8 8h40v4H8z" /></svg>
          <div class="frame u-stand"><JudoSprite frame={f.ukeStand} size={PX} /></div>
          <div class="frame u-bent"><JudoSprite frame={f.ukeBent} size={PX} /></div>
          <!-- Lifted, then thrown in 4 rotation steps; each step stays behind as a fading after-image -->
          {throwFrames.map(({ frame, left, bottom }, i) => (
            <div class={`frame u-throw u-throw-${i}`} style={`left: ${left}px; bottom: ${bottom}px`}>
              <JudoSprite frame={frame} size={PX} />
            </div>
          ))}
          <!-- Flat on the back, face up: the landing, with the impact effects -->
          <div class="frame u-ground" style={`left: ${throwSteps[3].cx - (width(f.ukeGround.body) * PX) / 2}px`}>
            <JudoSprite frame={f.ukeGround} size={PX} />
          </div>
          <!-- Alternates each loop with 一本! (in DotGothic16) -->
          <p class="ippon"><span>IPPON!</span></p>
        </div>
        <!-- The landing, in front of both fighters: dust both ways, white lines out from the point of impact -->
        <div class="actor impact" style={`left: ${throwSteps[3].cx}px`}>
          {impactDust.map(([dx, dy, size, color]) => <span class="burst" style={`--dx: ${dx}px; --dy: ${dy}px; --size: ${size}px; background: ${color}`}></span>)}
          {impactLines.map(([d, dx, dy]) => (
            <svg class="line" style={`--dx: ${dx}px; --dy: ${dy}px`} width="12" height="12" shape-rendering="crispEdges"><path d={d} /></svg>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="fx" aria-hidden="true">
    {Array.from({ length: TRAIL_POOL }, () => <span class="px"></span>)}
    {Array.from({ length: POINTS_POOL }, () => <span class="points">+100</span>)}
  </div>
</section>

<style>
  .hero {
    /* Cursor trail colours */
    --trail-a: #5cc8ff;
    --trail-b: #bfe0ff;
    --trail-c: #2b6cdb;
    position: relative;
    overflow: hidden;
    /* Starts under the floating header, so the galaxy shows through its glass */
    margin-top: calc(var(--header-h) * -1);
    padding-top: var(--header-h);
    padding-bottom: 48px;
  }

  /* The pale blue would vanish on the light sky: darker blues instead */
  :global([data-theme='light']) .hero {
    --trail-a: var(--accent);
    --trail-b: #2b6cdb;
    --trail-c: #1a4a9e;
  }

  /* Off screen: every loop in the hero holds still (the script stops its frame loop too) */
  .hero.is-paused *,
  .hero.is-paused *::before,
  .hero.is-paused *::after {
    animation-play-state: paused;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  p,
  h1 {
    margin: 0;
  }

  /* CRT scanlines on the background only: above the stars, below the content and the strip */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 2px, var(--scanline) 2px 4px);
    pointer-events: none;
  }

  /* ---------- Background: the pixel galaxy ---------- */

  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* The galaxy's own dithered fade, finished smooth: the About section's sky starts this colour */
  .sky::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 25%;
    background: linear-gradient(rgb(5 11 26 / 0), #050b1a);
  }

  :global([data-theme='light']) .sky::after {
    background: linear-gradient(rgb(207 227 248 / 0), #cfe3f8);
  }

  /* Low-resolution canvases scaled up by whole pixels (the script sets their size) */
  .sky canvas {
    position: absolute;
    top: 0;
    left: 0;
    image-rendering: pixelated;
  }

  /* Low tier: the pre-rendered galaxy (bottom-aligned, so its fade meets the About sky) */
  .sky-static {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    image-rendering: pixelated;
  }

  :global(html[data-tier='low']) .sky-static-dark {
    display: block;
  }

  :global(html[data-tier='low'][data-theme='light']) .sky-static-dark {
    display: none;
  }

  :global(html[data-tier='low'][data-theme='light']) .sky-static-light {
    display: block;
  }

  :global(html[data-tier='low']) .sky canvas {
    display: none;
  }

  /* Before the script sizes it (and without JS): no stretched blank canvas */
  .sky-canvas:not([style]) {
    display: none;
  }

  /* Parallax layers: the script moves them against the cursor (whole pixels, short ease) */
  .sky-layer {
    transition: transform 0.25s ease-out;
  }

  /* No hover (touch screens): each layer drifts on its own, one pixel at a time */
  @media (hover: none) {
    .sky-layer {
      animation: drift 24s steps(var(--steps)) infinite;
    }

    .sky-far {
      --amp: 4px;
      --steps: 4;
    }

    .sky-mid {
      --amp: 10px;
      --steps: 10;
      animation-duration: 18s;
      animation-direction: reverse;
    }

    .sky-near {
      --amp: 18px;
      --steps: 18;
      animation-duration: 14s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky-layer {
      animation: none;
    }
  }

  /* ---------- Cursor effects (positioned and played by the script, transform and opacity only) ---------- */

  .fx {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .px,
  .points {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .px {
    width: 4px;
    height: 4px;
    margin: -2px;
    background: var(--trail-a);
  }

  .px.is-big {
    width: 6px;
    height: 6px;
    margin: -3px;
  }

  .px.is-b {
    background: var(--trail-b);
  }

  .px.is-c {
    background: var(--trail-c);
  }

  .points {
    font-family: var(--font-pixel);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    color: var(--accent);
    text-shadow: 2px 2px 0 var(--bg);
  }

  /* ---------- Content ---------- */

  /* Shakes with the strip when Uke lands (the keyframes are with the judo loop) */
  .content {
    position: relative;
    z-index: 1;
    animation: shake 12s linear infinite;
    max-width: 1120px;
    margin: 0 auto;
    padding: 8px 24px 0;
  }

  .hud {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    font-family: var(--font-pixel);
    font-size: 11px;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--text);
  }

  .hud-accent {
    color: var(--accent);
  }

  .blink {
    animation: blink 1s steps(1) infinite;
  }

  .scroll-hint {
    position: absolute;
    bottom: 14px;
    left: 50%;
    z-index: 2;
    padding: 6px 8px;
    transform: translateX(-50%);
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    animation: blink 1.2s steps(1) infinite;
  }

  .scroll-hint:hover,
  .scroll-hint:focus-visible {
    color: var(--accent);
    animation: none;
  }

  /* Gone as soon as the page scrolls (see AboutQuick.astro) */
  .scroll-hint.is-gone {
    opacity: 0;
    animation: none;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .hud-coin.is-high {
    color: var(--accent);
    animation-duration: 0.5s;
  }

  /* Hugs the name, so the selection frame sits around the letters */
  .name {
    --headroom: 16px;
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-top: calc(40px - var(--headroom));
  }

  /* Clips the slide-up entrance and the scanline sweep; the top padding is room for the jumps */
  h1 {
    position: relative;
    padding-top: var(--headroom);
    overflow: hidden;
    font-weight: 800;
    /* ".ADEL" is ~3.55em wide: cap the size so it always fits the content width on one line */
    font-size: min(clamp(120px, 21vw, 320px), (100vw - 48px) / 3.6, 1072px / 3.6);
    line-height: 0.95;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .title {
    display: inline-block;
    animation: slide-up 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* A square pixel block in place of the period: inline-block with no content sits on the baseline */
  .dot {
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin-right: 0.08em;
    background: var(--accent);
    animation: cursor-blink 1.1s steps(1) infinite;
  }

  .letters {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  /* The script lifts the letter nearest the cursor (and a little, its neighbours) */
  .letter {
    display: inline-block;
    transition:
      transform 0.1s steps(2),
      color 0.3s ease;
  }

  .letter.is-near {
    color: var(--accent);
    transform: translateY(-6px);
    transition: transform 0.1s steps(2);
  }

  .letter.is-close {
    transform: translateY(-2px);
  }

  .glyph {
    display: inline-block;
  }

  .name.is-waving .letters > .letter > .glyph {
    animation: letter-wave 0.3s steps(3, jump-none) calc(var(--i) * 70ms);
  }

  /* Glitch: two coloured copies behind the letters, shifted for ~180ms */
  .ghost {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    opacity: 0;
  }

  .ghost-a {
    color: #5cc8ff;
  }

  .ghost-b {
    color: #2b6cdb;
  }

  .name.is-glitching .ghost-a {
    animation: glitch-a 0.18s steps(1, end);
  }

  .name.is-glitching .ghost-b {
    animation: glitch-b 0.18s steps(1, end);
  }

  .name.is-glitching .letters > .letter {
    animation: glitch-main 0.18s steps(1, end);
  }

  /* A thin bright band crossing the letters every ~5s (its box is the heading, its bar the top 3px) */
  .sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: sweep 5s steps(1, end) 1.5s infinite;
  }

  .sweep::before {
    content: '';
    position: absolute;
    top: -3px;
    right: 0;
    left: 0;
    height: 3px;
    background: var(--accent);
    opacity: 0.25;
  }

  /* ---------- Selection frame: 4 pixel corner brackets and blinking arrows ---------- */

  .select {
    position: absolute;
    top: calc(var(--headroom) - 8px);
    right: -8px;
    bottom: -4px;
    left: -8px;
    opacity: 0;
    pointer-events: none;
  }

  .name.is-selected .select {
    opacity: 1;
  }

  .corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border: 0 solid var(--accent);
  }

  .corner-tl {
    --from: 6px, 6px;
    top: 0;
    left: 0;
    border-width: 4px 0 0 4px;
  }

  .corner-tr {
    --from: -6px, 6px;
    top: 0;
    right: 0;
    border-width: 4px 4px 0 0;
  }

  .corner-bl {
    --from: 6px, -6px;
    bottom: 0;
    left: 0;
    border-width: 0 0 4px 4px;
  }

  .corner-br {
    --from: -6px, -6px;
    right: 0;
    bottom: 0;
    border-width: 0 4px 4px 0;
  }

  .name.is-selected .corner {
    animation: corner-in 0.15s steps(3, jump-none) both;
  }

  /* In the content gutter (24px), so they never push anything or overflow */
  .arrow {
    position: absolute;
    top: 50%;
    margin-top: -6px;
    font-family: var(--font-pixel);
    font-size: 12px;
    line-height: 1;
    color: var(--accent);
  }

  .arrow-l {
    left: -14px;
  }

  .arrow-r {
    right: -14px;
  }

  .name.is-selected .arrow {
    animation: blink 0.6s steps(1) infinite;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border: 2px solid var(--pixel-shadow);
    box-shadow: 6px 6px 0 var(--pixel-shadow);
    font-family: var(--font-pixel);
    font-size: 12px;
    text-decoration: none;
    transition:
      transform 0.12s steps(2),
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .btn:hover {
    transform: translate(-3px, -3px);

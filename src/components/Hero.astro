<script>
  import { downgrade, getSettings } from '../lib/quality';

  // "▶ START" and "Enter the garage" warp to /about through a pixel portal (3D on medium and high
  // tiers, a simple fade on low). Without JS they stay plain links.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const quality = getSettings();
  const PARTICLES = 30;
  const SPARKS_PER_BURST = 12;
  const SPARK_COLORS = ['#FFFFFF', '#BFE0FF', 'var(--accent)'];
  // The expand starts once the field has filled in (1.8s) and lasts 0.4s
  const EXPAND_DELAY = 1800;
  const EXPAND_DURATION = 400;
  // Frame cells [row, column] of the 4 × 5 grid, in build order: around the frame from the bottom
  const FRAME_CELLS = [
    [5, 2], [5, 1], [4, 1], [3, 1], [2, 1], [1, 1], [1, 2],
    [1, 3], [1, 4], [2, 4], [3, 4], [4, 4], [5, 4], [5, 3],
  ];
  // One glow block: 4 × 4 pixels of #1E5FBF with #0F3A80 spots, plus speckles that pulse (opacity only)
  const BLOCK_SVG =
    '<svg viewBox="0 0 4 4" preserveAspectRatio="none" shape-rendering="crispEdges">' +
    '<path fill="#1E5FBF" d="M0 0h4v4H0z"/>' +
    '<path fill="#0F3A80" d="M3 0h1v1H3zM0 1h1v1H0zM1 2h1v1H1zM3 3h1v1H3z"/>' +
    '<g class="warp-speckles"><path fill="#8FD4FF" d="M1 0h1v1H1zM0 3h1v1H0z"/><path fill="#FFFFFF" d="M3 1h1v1H3zM2 2h1v1H2z"/></g>' +
    '</svg>';

  const random = (min: number, max: number) => min + Math.random() * (max - min);

  /**
   * The screen is fully covered: hand over to the next page. Base.astro reads the colour from
   * sessionStorage, starts that page covered in it and fades it out (a direct visit has no key).
   */
  function go(url: string, color: string) {
    try {
      sessionStorage.setItem('warp-arrival', color);
    } catch {}
    location.assign(url);
  }

  // 0–0.4s: two bursts of sparks at the bottom center of the portal, 0.15s apart
  function createSparks(): HTMLElement {
    const sparks = document.createElement('div');
    sparks.className = 'warp-sparks';
    for (let burst = 0; burst < 2; burst++) {
      for (let i = 0; i < SPARKS_PER_BURST; i++) {
        const spark = document.createElement('span');
        spark.className = 'warp-spark';
        // Mostly upwards and sideways, like striking a lighter
        const angle = random(-175, -5) * (Math.PI / 180);
        const distance = random(18, 56);
        spark.style.cssText = [
          `--dx: ${Math.round(Math.cos(angle) * distance)}px`,
          `--dy: ${Math.round(Math.sin(angle) * distance)}px`,
          `--size: ${2 + Math.floor(Math.random() * 3)}px`,
          `--delay: ${burst * 0.15}s`,
          `background: ${SPARK_COLORS[i % SPARK_COLORS.length]}`,
        ].join(';');
        sparks.append(spark);
      }
    }
    return sparks;
  }

  function createPortal(): { overlay: HTMLElement; portal: HTMLElement } {
    const overlay = document.createElement('div');
    overlay.className = 'warp';
    overlay.setAttribute('aria-hidden', 'true');

    const sparks = createSparks();

    const portal = document.createElement('div');
    portal.className = 'warp-portal';

    // 0.9–1.8s: the swirling field fades in inside the frame
    const field = document.createElement('div');
    field.className = 'warp-field';
    for (let i = 0; i < PARTICLES; i++) {
      const particle = document.createElement('span');
      particle.className = 'warp-particle';
      particle.style.cssText = [
        `--angle: ${Math.round(Math.random() * 360)}deg`,
        // A share of the block size, so the swirl fills the window at every breakpoint
        `--radius: calc(var(--block) * ${random(0.25, 1.35).toFixed(2)})`,
        `--size: ${4 + 2 * Math.floor(Math.random() * 3)}px`,
        `--duration: ${random(0.7, 1.4).toFixed(2)}s`,
        `--delay: ${(-Math.random()).toFixed(2)}s`,
        `background: ${i % 2 ? '#7B5CFF' : 'var(--accent)'}`,
      ].join(';');
      field.append(particle);
    }
    portal.append(field);

    // 0.4–0.9s: the frame builds block by block
    FRAME_CELLS.forEach(([row, column], i) => {
      const block = document.createElement('div');
      block.className = 'warp-block';
      block.innerHTML = BLOCK_SVG;
      block.style.cssText = [
        `grid-row: ${row}`,
        `grid-column: ${column}`,
        `--delay: ${(0.4 + i * 0.03).toFixed(2)}s`,
        `--glow-delay: ${(-Math.random() * 1.6).toFixed(2)}s`,
      ].join(';');
      portal.append(block);
    });

    overlay.append(sparks, portal);
    return { overlay, portal };
  }

  /** The CSS portal: the fallback when WebGL or the three.js chunk isn't available */
  function playCssPortal(url: string) {
    const { overlay, portal } = createPortal();
    let done = false;
    // At full zoom the screen shows the portal's #1E5FBF backing
    const finish = () => {
      if (done) return;
      done = true;
      go(url, '#1E5FBF');
    };

    // Directly on <body>: no transformed ancestor can break position: fixed (iOS Safari)
    document.body.append(overlay);

    // Zoom until the 2 × 3-block window covers the overlay as it is actually laid out (100dvh on iOS)
    const block = parseFloat(getComputedStyle(overlay).getPropertyValue('--block'));
    const { width, height } = overlay.getBoundingClientRect();
    const cover = Math.max(width / (2 * block), height / (3 * block)) * 1.1;

    const expand = portal.animate([{ transform: 'scale(1)' }, { transform: `scale(${cover})` }], {
      duration: EXPAND_DURATION,
      delay: EXPAND_DELAY,
      easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
      fill: 'forwards',
    });
    expand.finished.then(finish);

    // Safety net in case the animation never finishes
    setTimeout(finish, 3500);
  }

  // ---------- Three.js portal: loaded on demand, never on page load ----------

  type ThreePortal = typeof import('../lib/warp-three');
  let threePortal: Promise<ThreePortal> | undefined;
  let threeReady = false;
  let webGL: boolean | undefined;

  const hasWebGL = () => {
    if (webGL === undefined) {
      try {
        const gl = document.createElement('canvas').getContext('webgl2') ?? document.createElement('canvas').getContext('webgl');
        webGL = !!gl;
        // Don't keep a context alive just for the check
        gl?.getExtension('WEBGL_lose_context')?.loseContext();
      } catch {
        webGL = false;
      }
    }
    return webGL;
  };

  /** Starts downloading the three.js chunk (once); a failed download is retried on the next call */
  function loadThree(): Promise<ThreePortal> {
    threePortal ??= import('../lib/warp-three').then(
      (module) => {
        threeReady = true;
        return module;
      },
      (error) => {
        threePortal = undefined;
        throw error;
      },
    );
    return threePortal;
  }

  const preloadThree = () => {
    if (quality.three && hasWebGL()) loadThree().catch(() => {});
  };

  /** Low tier: no portal, just the page fading to the background colour */
  function playFade(url: string) {
    const overlay = document.createElement('div');
    overlay.className = 'warp warp-fade';
    overlay.setAttribute('aria-hidden', 'true');
    document.body.append(overlay);
    const color = getComputedStyle(overlay).backgroundColor;
    const fade = overlay.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'ease-out', fill: 'forwards' });
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      go(url, color);
    };
    fade.finished.then(finish);
    setTimeout(finish, 600);
  }

  async function playThreePortal(url: string) {
    const overlay = document.createElement('div');
    overlay.className = 'warp warp-3d';
    overlay.setAttribute('aria-hidden', 'true');
    document.body.append(overlay);

    // Not downloaded yet: play the CSS spark ignition while it finishes loading
    const showSparks = !threeReady;
    if (showSparks) overlay.append(createSparks());

    let run: ReturnType<ThreePortal['playPortal']>;
    try {
      const { playPortal } = await loadThree();
      overlay.querySelector('.warp-sparks')?.remove();
      // Too slow for the portal: the next pages render one tier lower
      run = playPortal({ container: overlay, skipSparks: showSparks, quality, onSlow: () => downgrade() });
    } catch {
      // No WebGL context or no chunk: hand over to the CSS portal (its overlay goes on top first)
      playCssPortal(url);
      overlay.remove();
      return;
    }

    // Safety net: never leave the overlay up, even if the animation loop stalls
    const safety = setTimeout(() => run.cancel(), 6000);
    await run.done;
    clearTimeout(safety);
    // The canvas has faded to the overlay's background (var(--bg))
    go(url, getComputedStyle(overlay).backgroundColor);
  }

  // Back from the next page through the bfcache: the old overlay is still up
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) document.querySelectorAll('.warp').forEach((overlay) => overlay.remove());
  });

  document.querySelectorAll<HTMLAnchorElement>('a[data-warp]').forEach((link) => {
    // Usually downloaded by the time the click lands
    link.addEventListener('pointerenter', preloadThree);
    link.addEventListener('touchstart', preloadThree, { passive: true });
    link.addEventListener('focus', preloadThree);

    link.addEventListener('click', (event) => {
      // Let new-tab and other modified clicks through
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (document.querySelector('.warp')) return;

      // Fetch the next page's hero image now, so it's cached when the portal lands
      if (link.dataset.warpPreload) new Image().src = link.dataset.warpPreload;

      if (!quality.three) playFade(link.href);
      else if (hasWebGL()) playThreePortal(link.href);
      else playCssPortal(link.href);
    });
  });
</script>

<script>
  import { fighterVars, fighters, type Gi } from '../lib/fighters';

  /*
   * A new pair of fighters each time the 12s judo loop starts over (never the same one twice), Tori
   * in white and Uke in blue or the other way round; the IPPON! alternates with 一本!.
   */
  const cast = document.querySelector<HTMLElement>('.hero .cast');
  if (cast) {
    const tori = cast.querySelector<HTMLElement>('.tori')!;
    const uke = cast.querySelector<HTMLElement>('.uke')!;
    const ippon = cast.querySelector<HTMLElement>('.ippon')!;
    let loop = 0;
    const dress = (el: HTMLElement, index: number, gi: Gi) => {
      el.dataset.hair = fighters[index].style;
      for (const [name, value] of Object.entries(fighterVars(fighters[index], gi))) el.style.setProperty(name, value);
    };
    const pick = () => {
      const a = Math.floor(Math.random() * fighters.length);
      const b = (a + 1 + Math.floor(Math.random() * (fighters.length - 1))) % fighters.length;
      const swap = Math.random() < 0.5;
      dress(tori, a, swap ? 'blue' : 'white');
      dress(uke, b, swap ? 'white' : 'blue');
      const japanese = loop % 2 === 1;
      ippon.classList.toggle('is-ja', japanese);
      ippon.lang = japanese ? 'ja' : '';
      ippon.firstElementChild!.textContent = japanese ? '一本!' : 'IPPON!';
      loop++;
    };
    pick();
    // The loop restarts while everyone is faded out (cast-fade is at 0 opacity at the start)
    cast.addEventListener('animationiteration', (event) => {
      if (event.target === cast && event.animationName.includes('cast-fade')) pick();
    });
  }
</script>

<script>
  import { createGalaxy } from '../lib/galaxy';
  import { getSettings } from '../lib/quality';

  /*
   * Hero interactivity: the pixel galaxy, a pixel trail behind the cursor, star parallax, Tori
   * reacting to the cursor, and points for clicking. Pointer events only record state; one requestAnimationFrame
   * loop does all the work, and only runs while there is something to do and the hero is on screen.
   */
  const TRAIL_EVERY = 30;
  const TRAIL_LIFE = 500;
  const FACE_EVERY = 150;
  const POINTS = 100;
  const BONUS = 500;
  const TAP_SELECT = 2000;
  const HIGH_SCORE = 1000;
  const ANNOUNCE_EVERY = 500;
  const SCORE_KEY = 'hero-score';
  // Judo timeline (see the storyboard in the styles): Tori walks 0–20%, rolls 20–29.6% (standing
  // up from 28%), walks and stands 29.6–45%, goes under Uke and throws him 45–74.5%, then wins
  const LOOP = 12000;
  const canTurn = (p: number) => p < 20 || (p >= 28 && p < 45);
  const canHop = (p: number) => p < 20 || (p >= 29.6 && p < 45) || p >= 74.5;

  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) initArcade(hero);

  function initArcade(hero: HTMLElement) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const layers = [...hero.querySelectorAll<HTMLElement>('.sky-layer')].map((el) => ({
      el,
      depth: Number(el.dataset.depth),
      x: 0,
      y: 0,
    }));
    const trail = [...hero.querySelectorAll<HTMLElement>('.px')].map((el) => ({ el, until: 0, anim: undefined as Animation | undefined }));
    const floaters = [...hero.querySelectorAll<HTMLElement>('.points')];
    const tori = hero.querySelector<HTMLElement>('.tori')!;
    const toriBox = hero.querySelector<HTMLElement>('.t-stand')!;
    const toriHop = hero.querySelector<HTMLElement>('.tori-hop')!;
    const toriShadow = hero.querySelector<SVGElement>('.tori .shadow')!;
    const cast = hero.querySelector<HTMLElement>('.cast')!;
    const scoreEl = hero.querySelector<HTMLElement>('.hud-score')!;
    const coinEl = hero.querySelector<HTMLElement>('.hud-coin')!;
    const announcer = hero.querySelector<HTMLElement>('[data-announce]')!;
    const name = hero.querySelector<HTMLElement>('.name')!;
    const nameLetters = [...name.querySelectorAll<HTMLElement>('.letters > .letter')];
    const dot = name.querySelector<HTMLElement>('.dot')!;
    // Low tier: the CSS shows the pre-rendered galaxy instead, and nothing draws
    const galaxy = getSettings().galaxyAnimated
      ? createGalaxy({
          host: hero,
          sky: hero.querySelector<HTMLCanvasElement>('.sky-canvas')!,
          starLayers: [...hero.querySelectorAll<HTMLCanvasElement>('.sky-layer')],
          focus: [name.querySelector('h1')!, hero.querySelector<HTMLElement>('.hud')!],
        })
      : { frame() {}, resize() {}, setTheme() {}, setStill() {} };

    // The cursor, in viewport coordinates; "overUi" while it's on a button or link
    const pointer = { x: 0, y: 0, inside: false, overUi: false, moved: false };
    let lastSpawn = 0;
    let lastFace = 0;
    let nextTrail = 0;
    let nextFloater = 0;
    let facingLeft = false;
    let overTori = false;
    let hop: Animation | undefined;
    let visible = true;
    let frame = 0;
    let lastPointerType = 'mouse';
    let nearLetter = -1;
    let coin: Animation | undefined;
    let bonusUsed = false;
    let waveTimer = 0;
    let tapTimer = 0;
    let glitchTimer = 0;

    let score = 0;
    try {
      score = Number(sessionStorage.getItem(SCORE_KEY)) || 0;
    } catch {}
    let shown = score;
    renderScore();

    const motion = () => !reducedMotion.matches;
    const interactive = (target: EventTarget | null) => target instanceof Element && !!target.closest('a, button');

    /** Where the judo loop is, in % (always "anywhere" when the loop is off for reduced motion) */
    function loopProgress(): number | undefined {
      const time = cast.getAnimations()[0]?.currentTime;
      return time == null ? undefined : ((Number(time) % LOOP) / LOOP) * 100;
    }

    function wake() {
      if (!frame && visible) frame = requestAnimationFrame(tick);
    }

    // ---------- Frame loop ----------

    function tick(now: number) {
      frame = 0;
      const rect = hero.getBoundingClientRect();
      const tracking = pointer.inside && finePointer.matches;

      if (tracking && motion() && pointer.moved && !pointer.overUi && now - lastSpawn >= TRAIL_EVERY) {
        spawnPixel(pointer.x - rect.left, pointer.y - rect.top, now);
        lastSpawn = now;
        pointer.moved = false;
      }

      // The sky animates on its own (30fps), unless motion is reduced or the tab is hidden
      const skyRunning = motion() && !document.hidden;
      if (skyRunning) galaxy.frame(now);

      updateParallax(tracking && motion(), rect);
      updateProximity(tracking && !pointer.overUi && inside(name.getBoundingClientRect(), pointer.x, pointer.y));

      if (now - lastFace >= FACE_EVERY) {
        lastFace = now;
        updateTori(tracking);
      }

      if (shown < score) {
        // Ticks up through the tens like an arcade counter, faster when far behind
        shown = Math.min(score, shown + (score - shown > 500 ? 50 : 10));
        renderScore();
      }

      // Keep running while the cursor is in the hero or something is still catching up
      if (skyRunning || pointer.inside || shown < score || facingLeft !== wantsLeft()) wake();
    }

    // ---------- 1. Pixel trail ----------

    const TRAIL_CLASSES = ['', 'is-b', 'is-c'];

    function spawnPixel(x: number, y: number, now: number) {
      // Round robin through the pool; if the oldest pixel is still alive, 40 are on screen: skip
      const pixel = trail[nextTrail];
      if (pixel.until > now) return;
      nextTrail = (nextTrail + 1) % trail.length;

      const colour = TRAIL_CLASSES[Math.floor(Math.random() * 3)];
      pixel.el.className = `px ${colour} ${Math.random() < 0.5 ? 'is-big' : ''}`;
      // A little scatter, on whole pixels
      pixel.el.style.translate = `${Math.round(x + (Math.random() - 0.5) * 8)}px ${Math.round(y + (Math.random() - 0.5) * 8)}px`;
      pixel.anim?.cancel();
      pixel.anim = pixel.el.animate(
        [
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(8px)' },
        ],
        { duration: TRAIL_LIFE, easing: 'steps(4, end)', fill: 'forwards' },
      );
      pixel.until = now + TRAIL_LIFE;
    }

    function clearTrail() {
      trail.forEach((pixel) => {
        pixel.anim?.cancel();
        pixel.anim = undefined;
        pixel.until = 0;
      });
    }

    // ---------- 2. Parallax stars ----------

    function updateParallax(follow: boolean, rect: DOMRect) {
      // -1…1 from the hero's center; back to rest when the cursor leaves
      const nx = follow ? Math.max(-1, Math.min(1, (pointer.x - rect.left) / (rect.width / 2) - 1)) : 0;
      const ny = follow ? Math.max(-1, Math.min(1, (pointer.y - rect.top) / (rect.height / 2) - 1)) : 0;
      layers.forEach((layer) => {
        const x = Math.round(-nx * layer.depth);
        const y = Math.round(-ny * layer.depth);
        if (x === layer.x && y === layer.y) return;
        layer.x = x;
        layer.y = y;
        layer.el.style.transform = x || y ? `translate(${x}px, ${y}px)` : '';
      });
    }

    // ---------- 3. Tori reacts ----------

    function wantsLeft(): boolean {
      if (!pointer.inside || !finePointer.matches) return false;
      const box = toriBox.getBoundingClientRect();
      return pointer.x < box.left + box.width / 2;
    }

    function updateTori(tracking: boolean) {
      const left = wantsLeft();
      const progress = loopProgress();
      // Only turn while walking or standing, so the roll, the throw and the finish stay as drawn
      if (left !== facingLeft && (progress === undefined || canTurn(progress))) {
        facingLeft = left;
        tori.classList.toggle('is-facing-left', left);
      }

      // Hovering over him: one hop each time the cursor arrives
      const over = tracking && !pointer.overUi && isOverTori(pointer.x, pointer.y);
      if (over && !overTori) hopTori();
      overTori = over;
    }

    const inside = (box: DOMRect, x: number, y: number) => x >= box.left && x <= box.right && y >= box.top && y <= box.bottom;
    const isOverTori = (x: number, y: number) => inside(toriBox.getBoundingClientRect(), x, y);

    /** A quick two-frame ready-stance hop, never during the roll or the throw */
    function hopTori() {
      const progress = loopProgress();
      if (!motion() || (progress !== undefined && !canHop(progress))) return;
      if (hop?.playState === 'running') return;
      hop = toriHop.animate(
        [
          { transform: 'translateY(-12px)', easing: 'steps(1, end)' },
          { transform: 'translateY(-6px)', offset: 0.5, easing: 'steps(1, end)' },
          { transform: 'translateY(-6px)' },
        ],
        { duration: 240 },
      );
      // His shadow shrinks while he's off the ground (scale is separate from the loop's transform)
      toriShadow.animate([{ scale: '0.75' }, { scale: '0.85', offset: 0.5 }, { scale: '0.85' }], { duration: 240, easing: 'steps(1, end)' });
    }

    // ---------- 4. The name ----------

    // Idle glitch every 6–10s while the hero is on screen
    function scheduleGlitch() {
      clearTimeout(glitchTimer);
      glitchTimer = window.setTimeout(
        () => {
          if (motion()) {
            name.classList.add('is-glitching');
            window.setTimeout(() => name.classList.remove('is-glitching'), 200);
          }
          scheduleGlitch();
        },
        6000 + Math.random() * 4000,
      );
    }

    /** Hover (or a tap): the selection frame, a letter wave and the coin dot */
    function selectName() {
      name.classList.add('is-selected');
      if (!motion()) return;
      // Restart the wave from the first letter
      name.classList.remove('is-waving');
      void name.offsetWidth;
      name.classList.add('is-waving');
      clearTimeout(waveTimer);
      waveTimer = window.setTimeout(() => name.classList.remove('is-waving'), 300 + 70 * nameLetters.length);

      if (coin?.playState === 'running') return;
      // Up, a full turn on its Y axis in 4 frames, and back down
      coin = dot.animate(
        [
          { transform: 'translateY(0) rotateY(0deg)' },
          { transform: 'translateY(-24px) rotateY(180deg)' },
          { transform: 'translateY(0) rotateY(360deg)' },
        ],
        { duration: 480, easing: 'steps(4, end)' },
      );
    }

    function deselectName() {
      clearTimeout(tapTimer);
      name.classList.remove('is-selected');
      updateProximity(false);
    }

    /** The letter nearest the cursor lifts, its neighbours a little */
    function updateProximity(over: boolean) {
      let nearest = -1;
      if (over) {
        let best = Infinity;
        nameLetters.forEach((letter, i) => {
          const box = letter.getBoundingClientRect();
          const distance = Math.abs(pointer.x - (box.left + box.width / 2));
          if (distance < best) {
            best = distance;
            nearest = i;
          }
        });
      }
      if (nearest === nearLetter) return;
      nearLetter = nearest;
      nameLetters.forEach((letter, i) => {
        letter.classList.toggle('is-near', i === nearest);
        letter.classList.toggle('is-close', nearest >= 0 && Math.abs(i - nearest) === 1);
      });
    }

    // ---------- 5. Click for points ----------

    function renderScore() {
      scoreEl.textContent = String(Math.min(shown, 999999)).padStart(6, '0');
      if (shown >= HIGH_SCORE && !coinEl.classList.contains('is-high')) {
        coinEl.textContent = coinEl.dataset.highScore ?? '';
        coinEl.classList.add('is-high');
      }
    }

    function addPoints(x: number, y: number, points: number, label: string) {
      const before = score;
      score += points;
      try {
        sessionStorage.setItem(SCORE_KEY, String(score));
      } catch {}
      if (Math.floor(score / ANNOUNCE_EVERY) > Math.floor(before / ANNOUNCE_EVERY)) {
        announcer.textContent = (announcer.dataset.announce ?? '').replace('{score}', String(score));
      }

      if (!motion()) {
        // No floating "+100" and no count-up: the new score shows straight away
        shown = score;
        renderScore();
        return;
      }

      const floater = floaters[nextFloater];
      nextFloater = (nextFloater + 1) % floaters.length;
      floater.textContent = label;
      // Keep the wider pops inside the hero
      const half = (label.length * 12) / 2 + 4;
      const fitX = Math.max(half, Math.min(hero.clientWidth - half, x));
      floater.style.translate = `${Math.round(fitX)}px ${Math.round(y)}px`;
      floater.getAnimations().forEach((anim) => anim.cancel());
      floater.animate(
        [
          { opacity: 1, transform: 'translate(-50%, -50%)' },
          { opacity: 0, transform: 'translate(-50%, calc(-50% - 30px))' },
        ],
        { duration: 600, easing: 'steps(4, end)', fill: 'forwards' },
      );
      wake();
    }

    // ---------- Events ----------

    hero.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return;
        pointer.inside = true;
        pointer.overUi = interactive(event.target);
        if (!pointer.overUi) {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.moved = true;
        }
        wake();
      },
      { passive: true },
    );

    hero.addEventListener('pointerleave', () => {
      pointer.inside = false;
      pointer.moved = false;
      overTori = false;
      clearTrail();
      wake();
    });

    hero.addEventListener('click', (event) => {
      // Buttons and links keep their normal job; keyboard "clicks" (detail 0) only come from them anyway
      if (interactive(event.target) || event.detail === 0) return;
      const rect = hero.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      if (isOverTori(event.clientX, event.clientY)) hopTori();

      if (event.target instanceof Node && name.contains(event.target)) {
        // No hover on touch: the tap selects the name for a moment
        if (lastPointerType !== 'mouse') {
          selectName();
          clearTimeout(tapTimer);
          tapTimer = window.setTimeout(deselectName, TAP_SELECT);
        }
        // Once per page visit
        if (!bonusUsed) {
          bonusUsed = true;
          addPoints(x, y, BONUS, `+${BONUS} BONUS`);
          return;
        }
      }
      addPoints(x, y, POINTS, `+${POINTS}`);
    });

    hero.addEventListener('pointerdown', (event) => (lastPointerType = event.pointerType), { passive: true });

    name.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') selectName();
    });

    name.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') deselectName();
    });

    // Off screen: stop the loop and freeze the CSS loops too
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      hero.classList.toggle('is-paused', !visible);
      if (visible) {
        wake();
        scheduleGlitch();
      } else {
        clearTimeout(glitchTimer);
        cancelAnimationFrame(frame);
        frame = 0;
        clearTrail();
      }
    }).observe(hero);

    // ---------- The sky: size, theme and motion ----------

    const isLight = () => getComputedStyle(document.documentElement).colorScheme === 'light';
    galaxy.setTheme(isLight());
    galaxy.setStill(!motion());
    new ResizeObserver(() => galaxy.resize()).observe(hero);
    // The theme toggle swaps data-theme on <html>, which swaps the CSS variables (and color-scheme)
    new MutationObserver(() => galaxy.setTheme(isLight())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    reducedMotion.addEventListener('change', () => {
      galaxy.setStill(!motion());
      wake();
    });
    document.addEventListener('visibilitychange', wake);
  }
</script>

<!--
  The portal is built by the script above, so its styles can't be scoped.
  Timeline (~2.6s): sparks 0–0.4s · frame builds 0.4–0.9s · field fills 0.9–1.8s ·
  expands over the screen 1.8–2.2s (jump to the target) · overlay fades out 2.2–2.6s
-->
<style is:global>
  /* Fully opaque from the first frame; whole-pixel blocks per breakpoint so they line up exactly */
  .warp {
    --block: 40px;
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100%;
    height: 100dvh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--bg);
    pointer-events: all;
  }

  @media (min-width: 640px) {
    .warp {
      --block: 56px;
    }
  }

  .warp.is-out {
    animation: warp-out 0.4s ease-out both;
  }

  .warp-3d.is-out {
    animation-duration: 0.3s;
  }

  /* ---------- Spark ignition ---------- */

  /* A zero-size anchor at the bottom center of the portal (5 blocks tall, centered) */
  .warp-sparks {
    position: absolute;
    top: calc(50% + var(--block) * 2.5);
    left: 50%;
  }

  .warp-spark {
    position: absolute;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    opacity: 0;
    animation: warp-spark 0.25s ease-out var(--delay) forwards;
  }

  /* ---------- Frame of glowing blue blocks ---------- */

  .warp-portal {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, var(--block));
    grid-template-rows: repeat(5, var(--block));
    gap: 0;
  }

  /*
   * Behind the finished frame: one soft glow (the only shadow) and a base-blue backing, so no
   * sub-pixel seam between blocks can show through while the portal is scaled up
   */
  .warp-portal::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #1e5fbf;
    box-shadow: 0 0 28px 6px color-mix(in srgb, var(--accent) 35%, transparent);
    opacity: 0;
    pointer-events: none;
    animation: warp-fade-in 0.3s ease-out 0.95s both;
  }

  /*
   * Positioned so the blocks and the field paint above the backing. The pop-in is opacity only
   * (no transform, so a block's size can never get stuck), and jump-none reaches full opacity at
   * the halfway step instead of exactly at the end: an end-of-animation progress that rounds to
   * just under 1 (what left blocks at scale(0.5) on iOS) still shows the final value.
   */
  .warp-block {
    position: relative;
    margin: 0;
    animation: warp-block-pop 0.1s steps(2, jump-none) var(--delay) both;
  }

  .warp-block svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .warp-speckles {
    animation: warp-glow 0.8s ease-in-out var(--glow-delay) infinite alternate;
  }

  /* ---------- Swirling field ---------- */

  .warp-field {
    position: relative;
    grid-row: 2 / span 3;
    grid-column: 2 / span 2;
    overflow: hidden;
    background: #0b0f2e;
    animation: warp-fade-in 0.4s ease-out 0.9s both;
  }

  .warp-particle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    animation: warp-swirl var(--duration) linear var(--delay) infinite;
  }

  /* ---------- Keyframes (transform and opacity only; the expand runs from the script) ---------- */

  @keyframes warp-out {
    to {
      opacity: 0;
    }
  }

  @keyframes warp-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes warp-spark {
    from {
      transform: translate(0, 0);
      opacity: 1;
    }
    to {
      transform: translate(var(--dx), var(--dy));
      opacity: 0;
    }
  }

  @keyframes warp-block-pop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes warp-glow {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }

  /* Each particle orbits the center while spiralling inwards and spinning */
  @keyframes warp-swirl {
    from {
      transform: rotate(var(--angle)) translateX(var(--radius)) rotate(0deg);
      opacity: 0.2;
    }
    40% {
      opacity: 1;
    }
    to {
      transform: rotate(calc(var(--angle) + 360deg)) translateX(calc(var(--radius) * 0.2)) rotate(270deg);
      opacity: 0.2;
    }
  }
</style>

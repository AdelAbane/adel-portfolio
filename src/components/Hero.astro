  .actor[data-hair='short'] :global(.hair[data-style='short']),
  .actor[data-hair='buzz'] :global(.hair[data-style='buzz']),
  .actor[data-hair='ponytail'] :global(.hair[data-style='ponytail']),
  .actor[data-hair='bun'] :global(.hair[data-style='bun']),
  .actor[data-hair='braids'] :global(.hair[data-style='braids']),
  .actor[data-hair='afro'] :global(.hair[data-style='afro']),
  .actor[data-hair='tied'] :global(.hair[data-style='tied']) {

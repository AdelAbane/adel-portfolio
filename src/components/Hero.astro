  .frame {
    position: absolute;
    bottom: 0;
    left: 0;
    opacity: 0;
    /* Longhands: each pose only sets animation-name (a shorthand without a name compiles to "none") */
    animation-duration: 12s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }

  /* Each fighter shows its own hairstyle's layer (data-hair, set by the roster script) */
  .actor :global(.hair) {
    display: none;

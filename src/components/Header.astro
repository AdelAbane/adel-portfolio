---
import type { Translations } from '../i18n';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

const links = [
  { href: '#projects', label: t.header.nav.work },
  { href: '#about', label: t.header.nav.about },
  { href: '#quests', label: t.header.nav.quests },
  { href: '#contact', label: t.header.nav.contact },
];

const languages = [
  { code: 'en', label: 'EN', href: '/' },
  { code: 'fr', label: 'FR', href: '/fr' },
];
const otherLanguage = languages.find((lang) => lang.code !== locale)!;
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="#top"><span class="dot">.</span>adel</a>

    <nav aria-label={t.header.navLabel}>
      <ul class="links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <a class="lang" href={otherLanguage.href} hreflang={otherLanguage.code} aria-label={t.header.switchLanguage}>
        {languages.map((lang) => (
          <span class:list={{ current: lang.code === locale }} aria-hidden="true">
            {lang.label}
          </span>
        ))}
      </a>

      <button
        type="button"
        class="theme-toggle"
        aria-label={t.header.themeToLight}
        data-label-to-light={t.header.themeToLight}
        data-label-to-dark={t.header.themeToDark}
      >
        <svg class="icon-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  // No data-theme attribute means the default (dark) theme
  const currentTheme = () => (root.dataset.theme === 'light' ? 'light' : 'dark');

  const updateLabel = () => {
    if (!button) return;
    const label = currentTheme() === 'dark' ? button.dataset.labelToLight : button.dataset.labelToDark;
    if (label) button.setAttribute('aria-label', label);
  };

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    updateLabel();
  });

  // The server renders the dark-theme label; correct it if Base.astro restored light
  updateLabel();

  // Mark the nav link of the section currently in the middle of the screen as active
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-header .links a')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of navLinks) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  for (const link of navLinks) {
    const section = document.getElementById(link.hash.slice(1));
    if (section) observer.observe(section);
  }
</script>

<style>
  .inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    color: var(--text);
    text-decoration: none;
  }

  .dot {
    color: var(--accent);
  }

  .links {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 2px solid var(--border);
  }

  .links li + li {
    border-left: 2px solid var(--border);
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .links a:hover,
  .links a[aria-current] {
    background: var(--surface2);
    color: var(--text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang {
    display: flex;
    height: 44px;
    border: 2px solid var(--border);
    font-family: var(--font-pixel);
    font-size: 11px;
    text-decoration: none;
  }

  .lang:hover {
    border-color: var(--accent);
  }

  .lang span {
    display: grid;
    place-items: center;
    padding: 0 10px;
    color: var(--muted);
  }

  .lang .current {
    background: var(--accent);
    color: var(--on-accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 2px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
  }

  /* Sun in dark mode (click → light), moon in light mode (click → dark) */
  .icon-moon {
    display: none;
  }

  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .icon-moon {
    display: block;
  }

  a:focus-visible,
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Phones: logo + tools on the first row, nav box full width underneath */
  @media (max-width: 720px) {
    nav {
      order: 3;
      flex-basis: 100%;
    }

    .links li {
      flex: 1;
    }

    .links a {
      padding: 0 6px;
      font-size: 13px;
    }
  }
</style>

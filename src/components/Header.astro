---
import { cvHref, localeBase, type Translations } from '../i18n';

interface Props {
  t: Translations;
  /** Which page the header sits on: section links point back to the homepage from /about */
  page?: 'home' | 'about';
}

const { t, page = 'home' } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const base = localeBase(locale);
const onAbout = page === 'about';
const sectionHref = (hash: string) => (onAbout ? `${base}${hash}` : hash);

// On the homepage About scrolls to its quick section (START and "Enter the garage" warp to the full page)
const links = [
  { href: sectionHref('#projects'), label: t.header.nav.work },
  { href: onAbout ? `${base}about` : '#about', label: t.header.nav.about, current: onAbout },
  { href: sectionHref('#contact'), label: t.header.nav.contact },
];

const languages = [
  { code: 'en', label: 'EN', href: onAbout ? '/about' : '/' },
  { code: 'fr', label: 'FR', href: onAbout ? '/fr/about' : '/fr' },
];
const otherLanguage = languages.find((lang) => lang.code !== locale)!;
const cv = cvHref(locale);

// Pixel icons (crisp 1-unit squares): a down arrow onto a tray, and a battery with one bar (Lite mode)
const downloadIcon = 'M3 0h2v5h2v1H6v1H5v1H3V7H2V6H1V5h2zM0 9h8v1H0z';
const liteIcon = 'M1 1h9v1H1zM1 6h9v1H1zM0 2h1v4H0zM10 2h1v1h1v2h-1v1h-1zM2 3h2v2H2z';
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href={onAbout ? base : '#top'}><span class="dot" aria-hidden="true"></span>adel</a>

    <nav aria-label={t.header.navLabel}>
      <ul class="links">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      {onAbout && (
        <a class="back" href={base}>
          <span aria-hidden="true">◀</span> {t.about.back}
        </a>
      )}

      <a class="cv" href={cv} download aria-label={t.header.cvLabel}>
        <svg aria-hidden="true" width="12" height="15" viewBox="0 0 8 10" shape-rendering="crispEdges"><path fill="currentColor" d={downloadIcon} /></svg>
        {t.header.cv}
      </a>

      <a class="lang" href={otherLanguage.href} hreflang={otherLanguage.code} aria-label={t.header.switchLanguage}>
        {languages.map((lang) => (
          <span class:list={{ current: lang.code === locale }} aria-hidden="true">
            {lang.label}
          </span>
        ))}
      </a>

      <button
        type="button"
        class="theme-toggle"
        aria-label={t.header.themeToLight}
        data-label-to-light={t.header.themeToLight}
        data-label-to-dark={t.header.themeToDark}
      >
        <svg class="icon-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Lite mode: forces the low tier everywhere (no three.js), saved; the page reloads to apply it -->
      <button type="button" class="lite-toggle" aria-pressed="false" aria-label={t.header.lite} title={t.header.liteHint}>
        <svg aria-hidden="true" width="22" height="15" viewBox="0 0 12 8" shape-rendering="crispEdges"><path fill="currentColor" d={liteIcon} /></svg>
      </button>

      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="arcade-menu">
        {t.header.menu}
      </button>
    </div>
  </div>

  <!-- Phones: full-screen arcade menu (a modal dialog keeps focus inside and closes on Escape) -->
  <dialog id="arcade-menu" class="arcade-menu" aria-label={t.header.navLabel}>
    <button type="button" class="menu-close"><span aria-hidden="true">✕</span> {t.header.close}</button>
    <ul class="menu-links">
      {onAbout && (
        <li>
          <a href={base} autofocus>
            <span class="menu-cursor" aria-hidden="true">▶</span>
            <span aria-hidden="true">◀</span> {t.about.back}
          </a>
        </li>
      )}
      {links.map((link, i) => (
        <li>
          <a
            href={link.href}
            autofocus={i === 0 && !onAbout}
            aria-current={link.current ? 'page' : undefined}
          >
            <span class="menu-cursor" aria-hidden="true">▶</span>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a class="menu-cv" href={cv} download aria-label={t.header.cvLabel}>
          <span class="menu-cursor" aria-hidden="true">▶</span>
          <svg aria-hidden="true" width="16" height="20" viewBox="0 0 8 10" shape-rendering="crispEdges"><path fill="currentColor" d={downloadIcon} /></svg>
          {t.header.cv}
        </a>
      </li>
      <li>
        <button type="button" class="menu-lite lite-toggle" aria-pressed="false">
          <span class="menu-cursor" aria-hidden="true">▶</span>
          <svg aria-hidden="true" width="24" height="16" viewBox="0 0 12 8" shape-rendering="crispEdges"><path fill="currentColor" d={liteIcon} /></svg>
          {t.header.lite}
        </button>
      </li>
    </ul>
  </dialog>
</header>

<script>
  import { isLiteMode, setLiteMode } from '../lib/quality';

  // Lite mode: on or off, then reload so every part of the page picks its tier again
  const lite = isLiteMode();
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('.lite-toggle')) {
    toggle.setAttribute('aria-pressed', String(lite));
    toggle.addEventListener('click', () => {
      setLiteMode(!lite);
      window.location.reload();
    });
  }

  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;

  // The hero slides up under the floating header, and anchors stop below it: share its height
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    new ResizeObserver(() => root.style.setProperty('--header-h', `${header.offsetHeight}px`)).observe(header);
  }

  // No data-theme attribute means the default (dark) theme
  const currentTheme = () => (root.dataset.theme === 'light' ? 'light' : 'dark');

  const updateLabel = () => {
    if (!button) return;
    const label = currentTheme() === 'dark' ? button.dataset.labelToLight : button.dataset.labelToDark;
    if (label) button.setAttribute('aria-label', label);
  };

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    updateLabel();
  });

  // The server renders the dark-theme label; correct it if Base.astro restored light
  updateLabel();

  // Phone menu: open/close the arcade menu, keep aria-expanded in sync and lock the page scroll
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLDialogElement>('#arcade-menu');

  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.showModal();
      menuToggle.setAttribute('aria-expanded', 'true');
      root.classList.add('menu-open');
    });

    // Fires for every way of closing: ✕, an item, Escape
    menu.addEventListener('close', () => {
      menuToggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('menu-open');
    });

    menu.querySelector('.menu-close')?.addEventListener('click', () => menu.close());

    // Trap focus: Tab past the last item wraps to the first one and back
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = [...menu.querySelectorAll<HTMLElement>('button, a')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Close first, so the page is scrollable again when the link jumps to its section
    for (const link of menu.querySelectorAll('a')) {
      link.addEventListener('click', () => menu.close());
    }

    // The menu only exists on phones: close it if the screen grows past the breakpoint
    window.matchMedia('(min-width: 640px)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }

  // Mark the nav link of the section currently in the middle of the screen as active
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-header .links a[href^="#"]')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of navLinks) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  for (const link of navLinks) {
    const section = document.getElementById(link.hash.slice(1));
    if (section) observer.observe(section);
  }
</script>

<style>
  /*
   * A frosted glass bar floating over the page (the hero's galaxy starts under it). The pixel
   * touches stay: Press Start 2P on EN/FR and MENU, and the logo's square dot.
   */
  .site-header {
    --glass: rgba(10, 22, 48, 0.45);
    --glass-border: rgba(190, 224, 255, 0.16);
    --glass-highlight: rgba(255, 255, 255, 0.18);
    --glass-fill: rgba(190, 224, 255, 0.06);
    --glass-hover: rgba(190, 224, 255, 0.12);
    --glass-active: rgba(190, 224, 255, 0.2);
    --glass-shadow: rgba(2, 6, 20, 0.55);
    --glass-blur: blur(18px) saturate(160%);
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 16px 16px 0;
    /* Only the bar takes clicks, not the gap around it */
    pointer-events: none;
  }

  :global([data-theme='light']) .site-header {
    --glass: rgba(255, 255, 255, 0.55);
    --glass-border: rgba(10, 42, 94, 0.12);
    --glass-highlight: rgba(255, 255, 255, 0.8);
    --glass-fill: rgba(255, 255, 255, 0.3);
    --glass-hover: rgba(255, 255, 255, 0.6);
    --glass-active: rgba(255, 255, 255, 0.9);
    --glass-shadow: rgba(10, 42, 94, 0.18);
  }

  /* No backdrop blur: a more opaque bar keeps the text readable */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      --glass: rgba(10, 22, 48, 0.85);
    }

    :global([data-theme='light']) .site-header {
      --glass: rgba(255, 255, 255, 0.85);
    }
  }

  .inner,
  .arcade-menu {
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
  }

  .inner {
    max-width: 1168px;
    margin: 0 auto;
    padding: 10px 12px 10px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 12px 32px -12px var(--glass-shadow);
    pointer-events: auto;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    color: var(--text);
    text-decoration: none;
  }

  /* A square pixel block in place of the period: inline-block with no content sits on the baseline */
  .dot {
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin-right: 0.08em;
    background: var(--accent);
  }

  /* Glass controls: the nav pill group, the way back, EN/FR, the theme and MENU buttons */
  .links,
  .back,
  .cv,
  .lang,
  .theme-toggle,
  .tools > .lite-toggle,
  .menu-toggle,
  .menu-close {
    border: 1px solid var(--glass-border);
    background: var(--glass-fill);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
  }

  .links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 3px;
    list-style: none;
    border-radius: 999px;
  }

  .links a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .links a:hover {
    background: var(--glass-hover);
    color: var(--text);
  }

  .links a[aria-current] {
    background: var(--glass-active);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    color: var(--text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* About page: the way back to the homepage */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .back:hover {
    background: var(--glass-hover);
  }

  .lang {
    display: flex;
    gap: 2px;
    height: 44px;
    padding: 3px;
    border-radius: 999px;
    font-family: var(--font-pixel);
    font-size: 10px;
    text-decoration: none;
  }

  .lang span {
    display: grid;
    place-items: center;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--muted);
  }

  .lang:hover span:not(.current) {
    background: var(--glass-hover);
    color: var(--text);
  }

  .lang .current {
    background: var(--glass-active);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    color: var(--text);
  }

  /* The CV: a pixel arrow and the pixel font, like EN/FR */
  .cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .cv svg {
    color: var(--accent);
  }

  .cv:hover {
    background: var(--glass-hover);
  }

  .tools > .lite-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    color: var(--muted);
    cursor: pointer;
  }

  .tools > .lite-toggle:hover {
    background: var(--glass-hover);
    color: var(--text);
  }

  /* Needs JS (it saves a setting and reloads) */
  :global(html:not(.js)) .lite-toggle {
    display: none;
  }

  /* On: lit up like the current language */
  .tools > .lite-toggle[aria-pressed='true'] {
    background: var(--glass-active);
    color: var(--accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    color: var(--text);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .menu-toggle:hover,
  .menu-close:hover {
    background: var(--glass-hover);
  }

  /* Sun in dark mode (click → light), moon in light mode (click → dark) */
  .icon-moon {
    display: none;
  }

  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .icon-moon {
    display: block;
  }

  /* Only shown on phones (with JS) */
  .menu-toggle {
    display: none;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-pixel);
    font-size: 10px;
    cursor: pointer;
  }

  /* ---------- Arcade menu ---------- */

  .arcade-menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 16px 24px 32px;
    border: 0;
    color: var(--text);
    pointer-events: auto;
  }

  .arcade-menu[open] {
    display: flex;
    flex-direction: column;
  }

  /* A little denser than the bar: the menu covers the whole page */
  .arcade-menu {
    --glass: rgba(10, 22, 48, 0.62);
  }

  :global([data-theme='light']) .arcade-menu {
    --glass: rgba(255, 255, 255, 0.7);
  }

  /* The page shows through, frosted (the dialog itself carries the glass) */
  .arcade-menu::backdrop {
    background: transparent;
  }

  .menu-close {
    align-self: flex-end;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-pixel);
    font-size: 10px;
    cursor: pointer;
  }

  /* Press Start 2P has no ✕, so the fallback glyph needs a bigger size to match */
  .menu-close span {
    font-size: 14px;
  }

  .menu-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-links a {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    font-family: var(--font-pixel);
    font-size: clamp(18px, 6vw, 26px);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .menu-lite {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-pixel);
    /* No uppercase: the pixel font has no capital É (Mode léger) */
    font-size: clamp(14px, 4.5vw, 18px);
    color: var(--muted);
    cursor: pointer;
  }

  .menu-lite[aria-pressed='true'] {
    color: var(--accent);
  }

  .menu-links :is(.menu-cv, .menu-lite) svg {
    flex: none;
  }

  .menu-lite:hover,
  .menu-lite:focus,
  .menu-links a:hover,
  .menu-links a:focus {
    color: var(--accent);
    outline: none;
  }

  /* The blinking ▶ cursor marks the focused or hovered item */
  .menu-cursor {
    flex: none;
    color: var(--accent);
    opacity: 0;
  }

  .menu-links a:hover .menu-cursor,
  .menu-links a:focus .menu-cursor,
  .menu-lite:hover .menu-cursor,
  .menu-lite:focus .menu-cursor {
    opacity: 1;
    animation: menu-blink 0.8s steps(1) infinite;
  }

  @keyframes menu-blink {
    50% {
      opacity: 0;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  a:focus-visible,
  .tools > .lite-toggle:focus-visible,
  .theme-toggle:focus-visible,
  .menu-toggle:focus-visible,
  .menu-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Small screens: logo + tools on the first row, nav box full width underneath */
  @media (max-width: 720px) {
    nav {
      order: 3;
      flex-basis: 100%;
    }

    .links li {
      flex: 1;
    }

    .links a {
      padding: 0 6px;
      font-size: 13px;
    }

    .links {
      gap: 0;
    }
  }

  /* Phones (with JS): one row, the nav moves into the MENU overlay; a lighter blur for performance */
  @media (max-width: 639px) {
    .site-header {
      --glass-blur: blur(10px) saturate(160%);
    }

    .inner {
      padding: 8px 8px 8px 20px;
    }

    :global(.js) .inner {
      flex-wrap: nowrap;
    }

    .tools {
      gap: 8px;
    }

    :global(.js) nav {
      display: none;
    }

    :global(.js) .menu-toggle {
      display: grid;
    }

    /* No room in the bar on phones: the way back, the CV and Lite mode are in the MENU overlay */
    .back,
    :global(.js) .cv,
    .tools > .lite-toggle {
      display: none;
    }
  }
</style>

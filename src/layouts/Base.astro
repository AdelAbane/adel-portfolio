---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'fr';
}

const { title, description = '', lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Apply saved theme before first paint to avoid a flash; flag JS so phones can swap the nav for the menu -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Arrived through the START portal: start covered in the portal's colour, then fade it out
      // (the page's own scripts listen for 'warp:arrived'; a direct visit has no key)
      try {
        const cover = sessionStorage.getItem('warp-arrival');
        if (cover) {
          sessionStorage.removeItem('warp-arrival');
          const root = document.documentElement;
          root.style.setProperty('--warp-arrival', cover);
          root.dataset.warpArrival = '';
          document.addEventListener('DOMContentLoaded', () => {
            root.classList.add('warp-arrival-out');
            setTimeout(() => {
              delete root.dataset.warpArrival;
              root.classList.remove('warp-arrival-out');
              document.dispatchEvent(new Event('warp:arrived'));
            }, 500);
          });
        }
      } catch (e) {}
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500&family=Barlow+Condensed:ital,wght@0,600;1,800&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&family=Unbounded:wght@500;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
